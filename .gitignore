# Git ignore rules reduce tracked/generated files; they do not control Codex AI scan scope. Keep the AI workspace opened at ChatBot only.

# Python caches and build output
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Local environment and secrets
.env
.env.*
!.env.example
!.env.sample

# Runtime state
data/
*.sqlite
*.sqlite3
*.db
*.log
logs/

# Local planning / agent scratch
.planning/
.superpowers/
.worktrees/

# Local generated artifacts, backups, and abandoned experiments
tmp/
backups/
_crawlwiki_patch2/

# Downloaded or extracted third-party research sources.
# Keep the curated Markdown reports and lightweight index files tracked.
research/nonebot_plugin_sources/_downloads/
research/nonebot_plugin_sources/_downloads_second_batch/
research/nonebot_plugin_sources/extracted/
research/nonebot_plugin_sources/extracted_second_batch/
research/gscore_sources/*/
research/meme_plugins/
research/store_searches/
# 参考源码与调研材料（只提交分析报告，不提交第三方源码树）
research/astrbot_plugin_parser/
research/plugin_sources/

# OS and editor noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# 离线参考：bilibili-api-python sdist（GPL-3.0，仅挖掘端点用，不入库）
research/bilibili_api_sdists/

# pytest sandbox basetemp
.pytest_tmp*/

# third-party NoneBot localstore config (actual runtime location is ChatBot_Runtime\\config)
config/
