  },
  "component": {
    "$description": "材质配方。recipe 是本仓「好看」的可验收形式：定值 + 上限 + 降级路径三件齐。",
    "glass": {
      "$description": "液态玻璃。每个视口最多 3 面（侧栏 window / 顶栏 mica-bar / 主内容 content-field），禁嵌套。",
      "blur": {
        "$value": "18px",
        "$type": "dimension",
        "max": "40px"
      },
      "saturate": {
        "$value": "148%",
        "$type": "percentage"
      },
      "borderStrength": {
        "$value": 0.56,
        "$type": "number",
        "note": "消费方乘 70% 得 39% 墨色描边"
      },
      "top": {
        "$value": "inset 0 1px 0 color-mix(in srgb, oklch(1 0 0) 62%, transparent)",
        "$type": "shadow"
      },
      "bottom": {
        "$value": "inset 0 -1px 0 color-mix(in srgb, var(--foreground) 8%, transparent)",
        "$type": "shadow"
      },
      "rim": {
        "$value": "0 0 0 1px color-mix(in srgb, var(--foreground) 7%, transparent)",
        "$type": "shadow"
      },
      "glow": {
        "$value": "0 18px 40px color-mix(in srgb, var(--sk-deep) 12%, transparent), 0 4px 12px color-mix(in srgb, var(--foreground) 6%, transparent)",
        "$type": "shadow"
      },
      "fallback": {
        "$value": "@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)))",
        "$type": "string",
        "note": "不支持时玻璃退成 94~96% 实面：保留层次、放弃通透。描边与投影不动，版式观感不变。"
      }
    },
    "mica": {
      "$description": "云母。Win11 Mica 的网页仿制：底材从缝里透，内容坐在填充层上。",
      "panelOpacity": {
        "$value": "90%",
        "$type": "percentage",
        "note": "W18 阶段 1 由 72% 提高。72% 时 muted 正文在面板上只有 3.6:1。"
      },
      "sidedOpacity": {
        "$value": "90%",
        "$type": "percentage"
      },
      "headerOpacity": {
        "$value": "86%",
        "$type": "percentage"
      },
      "blur": {
        "$value": "blur(30px) saturate(1.4)",
        "$type": "string"
      },
      "contentFieldOpacity": {
        "$value": "74%",
        "$type": "percentage",
        "note": "主内容阅读面。正文不再直接压在动态背景上。"
      },
      "noise": {
        "$value": "两层交叉 radial-gradient 网纹（0.6px / 0.5px 点阵）",
        "$type": "string",
        "note": "不用 feTurbulence data URI：⑩ 定义侧对 url( 一律判红，且那条规则在防背景图夹带远端资源。"
      }
    },
    "iridescent": {
      "$description": "油膜虹彩流光（原需求写「动态油壶渐变色」，按语音输入推断为油膜）。只用于 accents：当前选中导航项、页标题釉线、品牌环。",
      "period": {
        "$value": "14s",
        "$type": "duration",
        "min": "12s"
      },
      "angleProperty": {
        "$value": "--iris-angle",
        "$type": "string",
        "syntax": "<angle>",
        "inherits": false,
        "initialValue": "0deg",
        "note": "不注册则 CSS 无法插值自定义属性，虹彩只剩静止渐变"
      },
      "lineMask": {
        "$value": "linear-gradient(to right, transparent, black 18%, black 82%, transparent)",
        "$type": "string"
      },
      "ringMask": {
        "$value": "linear-gradient(black, black) padding-box, linear-gradient(black, black)",
        "$type": "string"
      },
      "ringComposite": {
        "$value": "exclude",
        "$type": "string"
      },
      "consumers": {
        "$value": [
          ".iridescent-line::after",
          ".iridescent-ring::after",
          ".brand-ring::after"
        ],
        "$type": "array"
      },
      "lightStroke": {
        "$value": "--iris-stroke",
        "$type": "alias",
        "endpoints": [
          "var(--brand-accent)",
          "oklch(0.46 0.1875 299.5)",
          "oklch(0.40 0.1494 269.3)"
        ],
        "note": "浅色档虹彩：两个非品牌端点压暗。实测虹彩数字 7.41:1（原 1.9:1）"
      },
      "darkStroke": {
        "$value": "--iris-stroke",
        "$type": "alias",
        "endpoints": [
          "oklch(0.66 0.1427 250.8)",
          "oklch(0.66 0.1875 299.5)",
          "oklch(0.66 0.1494 269.3)"
        ],
        "note": "深色档虹彩：三端点提亮到 L=0.66。实测 4.36:1（原 2.46:1）。⚠ 不能在 .dark 里改 --sk-purple/--sk-deep/--brand-accent —— appearance-wiring.css 的 html:root (0,1,1) 会压掉 .dark (0,1,0)"
      }
    },
    "particles": {
      "$description": "气泡场。单背景层、可整层关闭、WebGL2 与 canvas2d 双路。",
      "min": {
        "$value": 26,
        "$type": "number"
      },
      "max": {
        "$value": 74,
        "$type": "number"
      },
      "formula": {
        "$value": "viewportWidth / 20",
        "$type": "string",
        "$source": "webui/src/lib/effects/bubble-field.ts:88",
        "clamp": [
          26,
          74
        ]
      },
      "zIndex": {
        "$value": -25,
        "$type": "number"
      },
      "dprCap": {
        "$value": 2,
        "$type": "number"
      },
      "stopOn": {
        "$value": [
          "IntersectionObserver ≤1%",
          "visibilitychange hidden",
          "data-saver=1",
          "motion tier = off"
        ],
        "$type": "array"
      }
    },
    "scrollProgress": {
      "height": {
        "$value": "2px",
        "$type": "dimension"
      },
      "alpha": {
        "$value": 0.8,
        "$type": "number"
      },
      "background": {
        "$value": "var(--brand-grad)",
        "$type": "string"
      }
    },
    "bootCurtain": {
      "holdMs": {
        "$value": 520,
        "$type": "duration",
        "$source": "webui/src/components/effects/boot-curtain.tsx"
      },
      "lingerMs": {
        "$value": 1100,
        "$type": "duration",
        "$source": "webui/src/components/effects/boot-curtain.tsx"
      },
      "safetyMs": {
        "$value": 2600,
        "$type": "duration",
        "$source": "webui/src/components/effects/boot-curtain.tsx"
      },
      "sessionGated": {
        "$value": true,
        "$type": "boolean"
      },
      "storageKey": {
        "$value": "webui:boot-curtain-seen",
        "$type": "string",
        "$source": "webui/src/components/effects/boot-curtain.tsx:14"
      }
    },
    "reveal": {
      "rootMargin": {
        "$value": "0px 0px -12% 0px",
        "$type": "string",
        "$source": "webui/src/lib/effects/use-reveal.ts:24"
      },
      "threshold": {
        "$value": 0.12,
        "$type": "number"
      },
      "stepSeconds": {
        "$value": 0.09,
        "$type": "duration"
      },
      "maxSteps": {
        "$value": 5,
        "$type": "number"
      },
      "firstScreen": {
        "$value": "已在视口内直接 in，不闪",
        "$type": "string"
      }
    },
    "customCursor": {
      "dot": {
        "$value": "4px",
        "$type": "dimension"
      },
      "ring": {
        "$value": "34px",
        "$type": "dimension"
      },
      "hoverRing": {
        "$value": "56px",
        "$type": "dimension"
      },
      "lerp": {
        "$value": 0.16,
        "$type": "number"
      },
      "epsilon": {
        "$value": 0.1,
        "$type": "number"
      },
      "nativeCursor": {
        "$value": "never hidden",
        "$type": "string",
        "$external": true,
        "note": "原生光标从不隐藏。自定义光标是叠加层而非替代：JS 崩溃、组件未挂载、或动效档位为 off 时，系统光标照常可用。"
      }
    },
    "focusIndicator": {
      "$description": "焦点指示器。WCAG 1.4.11 要求对相邻色 >=3:1。",
      "outline": "2px solid var(--brand-accent)",
      "offset": "2px",
      "activeStateColor": "var(--foreground)",
      "darkColor": "color-mix(in srgb, var(--foreground) 88%, transparent)",
      "note": "激活态元素（aria-current/aria-selected/data-state=on）上用 --foreground 而不是品牌色：品牌色底+品牌色环 = 1:1，等于没画"
    },
    "drawer": {
      "$description": "移动导航抽屉。",
      "position": "fixed",
      "top": "5rem",
      "maxHeight": "calc(100dvh - 7rem)",
      "zIndex": 30,
      "role": "dialog",
      "ariaModal": "true",
      "note": "原先是文档流里的 nav，在 3638px 长页中段点开落在视口外（y=-3638）。改成 fixed 后 y=80、高 732、18/18 链接可见"
    }
  },
  "motionTiers": {
    "$description": "三档动效。判据全部来自 Environment facts，不是随机或时间。",
    "off": {
      "$value": [
        "prefers-reduced-motion: reduce",
        "用户在外观页关掉动效"
      ],
      "$type": "array",
      "result": "无动画、无粒子、无自定义光标；功能全保留"
    },
    "lite": {
      "$value": [
        "data saver 开",
        "hardwareConcurrency ≤ 2",
        "viewport ≤ 900px"
      ],
      "$type": "array",
      "result": "粒子降为 canvas2d 且数量减半，光标与倾斜关闭"
    },
    "full": {
      "$value": [
        "以上都不成立"
      ],
      "$type": "array",
      "result": "WebGL2 粒子（不可用时降 canvas2d）、自定义光标、reveal 全开"
    }
  },
  "antiPatterns": {
    "$description": "本仓明令禁止的写法，每条都有机器门在执法 —— 列在这里是为了让「不要做什么」也变成可验收项。",
    "bareHex": "CSS 里不写裸 #rrggbb（版式宪法 ⑩）",
    "urlInCss": "CSS 里不写 url()（防背景图夹带远端资源）",
    "inlineCssVarWrite": "JS 里 setProperty('--x') / cssText 拼变量 / style['--x'] 一律判红；唯一合法通道是 lib/appearance/apply.ts 的动态名 setProperty",
