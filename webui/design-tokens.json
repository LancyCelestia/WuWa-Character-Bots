        "$value": "oklch(0.248 0.0329 273.6)",
        "$type": "color"
      },
      "foreground": {
        "$value": "oklch(0.946 0.0017 247.8)",
        "$type": "color"
      },
      "card": {
        "$value": "oklch(0.286 0.0375 273)",
        "$type": "color"
      },
      "muted": {
        "$value": "oklch(0.308 0.0255 275.4)",
        "$type": "color"
      },
      "mutedForeground": {
        "$value": "oklch(0.778 0.0084 253.9)",
        "$type": "color"
      },
      "primary": {
        "$value": "oklch(0.669 0.1427 250.8)",
        "$type": "color"
      },
      "primaryForeground": {
        "$value": "oklch(0.254 0.0383 274.7)",
        "$type": "color"
      },
      "secondary": {
        "$value": "oklch(0.322 0.0343 275.1)",
        "$type": "color"
      },
      "accent": {
        "$value": "oklch(0.367 0.0389 303.2)",
        "$type": "color"
      },
      "accentForeground": {
        "$value": "oklch(0.946 0.0017 247.8)",
        "$type": "color"
      },
      "destructive": {
        "$value": "oklch(0.68 0.2 22.5)",
        "$type": "color"
      },
      "success": {
        "$value": "oklch(0.661 0.1123 159.1)",
        "$type": "color"
      },
      "border": {
        "$value": "oklch(0.4 0.0258 273.4)",
        "$type": "color"
      },
      "ring": {
        "$value": "oklch(0.669 0.1427 250.8)",
        "$type": "color"
      }
