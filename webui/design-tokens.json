        "alias": "--wash-mist"
      },
      "foreground": {
        "$value": "oklch(0.291 0.0448 272.6)",
        "$type": "color"
      },
      "card": {
        "$value": "oklch(0.988 0.0017 247.8)",
        "$type": "color"
      },
      "muted": {
