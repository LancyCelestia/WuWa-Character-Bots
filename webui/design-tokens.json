{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "守岸人 WebUI 设计令牌（W18 阶段 1）。每一枚都是**当前 index.css 的真实值**，不是提案；复跑 `node webui/scripts/token-dump.mjs` 可整份重新生成并比对漂移。分三层：primitive（原始值，无人直接消费）→ semantic（界面消费的那一层）→ component（材质配方）。",
  "meta": {
    "generatedFrom": "webui/src/index.css",
    "generator": "webui/scripts/token-dump.mjs",
    "gates": [
      "webui/scripts/layout-constitution.mjs（版式宪法 196/196）",
      "webui/scripts/glass-budget.mjs（玻璃层数/blur/降级）",
      "webui/scripts/contrast-audit.mjs（真实像素对比度）"
    ],
    "ratifiedAgainst": {
      "ttlDesktopMs": 2000,
      "ttlMobileMs": 3500,
      "lighthousePerfDesktop": 85,
      "lighthousePerfMobile": 70,
      "lighthouseA11y": 90,
      "clsMax": 0.1,
      "longTasksIn5s": 3,
      "bodyContrast": 4.5,
      "largeTextContrast": 3,
      "glassSurfacesPerViewportMax": 3,
      "iridescentPeriodMinSeconds": 12,
      "particleCountMax": 74,
      "blurRadiusMaxPx": 40
    }
  },
  "primitive": {
    "radius": {
      "$description": "三档圆角。版式宪法 `TIER_DEF_NAMES` 只认 {14,18,30} 三个值加 0 与百分比几何圆 —— 再加第四档会被门判红。",
      "tile": {
        "$value": "14px",
        "$type": "dimension"
      },
      "panel": {
        "$value": "18px",
        "$type": "dimension"
      },
      "shell": {
        "$value": "30px",
        "$type": "dimension"
      }
    },
    "space": {
      "$description": "间距基数由 Tailwind v4 的 `--spacing` 提供（默认 0.25rem），版式宪法只允许它等于 0.25rem 或 4px 两种写法，全站 padding/margin/gap 必须落在它的整数倍。",
      "$source": "tailwindcss@4 默认 theme（不在本仓 CSS 里）",
      "unit": {
        "$value": "0.25rem",
        "$type": "dimension",
        "$external": true,
        "note": "Tailwind v4 的 `--spacing`（默认 0.25rem = 4px）。本仓从不声明它，改它等于换栅格 —— 版式宪法会当场红。"
      }
    },
    "fontSize": {
      "$description": "字号五档。所有 font-size 必须落在这五个值之一（含 rem 与 px 两种写法等价判定）。",
      "page": {
        "$value": "18px",
        "$type": "dimension"
      },
      "card": {
        "$value": "14px",
        "$type": "dimension"
      },
      "body": {
        "$value": "14px",
        "$type": "dimension"
      },
      "caption": {
        "$value": "12px",
        "$type": "dimension"
      },
      "num": {
        "$value": "30px",
        "$type": "dimension"
      }
    },
    "fontWeight": {
      "$description": "字重上限 700。只允许 thin..bold 六档命名值，数字字面量判红。",
      "max": {
        "$value": 700,
        "$type": "number"
      }
    },
    "fontFamily": {
      "$description": "系统字体栈，不自托管 woff2。理由：用户服务器 20GiB/月 与首屏 TTI 双约束下，一套 CJK 子集字体动辄 1.5-3 MiB，是单次加载占比最大的一项；而「有性格的字体」在中文场景下收益远低于带宽成本。⑩ 定义侧校验 `--font-sans` 只能落系统栈。",
      "sans": {
        "$value": "'Segoe UI', 'Microsoft YaHei', 'PingFang SC', -apple-system, BlinkMacSystemFont, Roboto, sans-serif",
        "$type": "fontFamily"
      },
      "mono": {
        "$value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
        "$type": "fontFamily"
      }
    },
    "duration": {
      "$description": "全站唯一的时长来源。每一枚都取自 index.css 实际写法；新增时长请先看这张表能不能复用，别再造一个 0.73s。",
      "$source": "webui/src/index.css",
      "micro": {
        "$value": "55ms",
        "$type": "duration",
        "note": "按下反馈（scale/translate 的瞬时回弹）"
      },
      "hover": {
        "$value": "220ms",
        "$type": "duration",
        "note": "hover 态过渡（描边、底色、位移）"
      },
      "quick": {
        "$value": "260ms",
        "$type": "duration",
        "note": "面板抬起、shadows 过渡"
      },
      "reveal": {
        "$value": "0.45s",
        "$type": "duration",
        "note": "自定义光标环的 hover 放大"
      },
      "settle": {
        "$value": "0.6s",
        "$type": "duration",
        "note": "导航指示器位移（参考站 pill 同值）"
      },
      "panelIn": {
        "$value": "0.9s",
        "$type": "duration",
        "note": "路由切换的面板入场"
      },
      "fold": {
        "$value": "1.1s",
        "$type": "duration",
        "note": "首帧幕布离场"
      },
      "irisShift": {
        "$value": "14s",
        "$type": "duration",
        "min": "12s",
        "note": "虹彩流转周期；<12s 会被读成加载指示器"
      },
      "blobDriftA": {
        "$value": "28s",
        "$type": "duration",
        "note": "光斑 A 漂移"
      },
      "blobDriftB": {
        "$value": "41s",
        "$type": "duration",
        "note": "光斑 B 漂移"
      },
      "blobDriftC": {
        "$value": "53s",
        "$type": "duration",
        "note": "光斑 C 漂移"
      },
      "brandRingSpin": {
        "$value": "120s",
        "$type": "duration",
        "note": "品牌环慢转（参考站同值）"
      }
    },
    "easing": {
      "outQuint": {
        "$value": "cubic-bezier(0.22, 1, 0.36, 1)",
        "$type": "cubicBezier"
      },
      "spring": {
        "$value": "cubic-bezier(0.32, 0.72, 0, 1)",
        "$type": "cubicBezier"
      }
    }
  },
  "semantic": {
    "$description": "界面真正消费的一层。浅色与深色分别给值；两边同名同义，只有值不同。",
