WUWA_RUNTIME_ENABLED=true
WUWA_RUNTIME_DEFAULT_PERSONA=shorekeeper
WUWA_RUNTIME_GROUP_COMMAND_PREFIX=/wuwa
# 角色昵称命令别名：设置后可用 "/岸宝帮助"、"/岸宝状态"、"/岸宝为什么" 等。
WUWA_RUNTIME_PERSONA_NICKNAME=岸宝
WUWA_RUNTIME_ALIAS_ENABLED=true

# 角色名单支持 JSON 数组、英文逗号或分号分隔；这里只放 QQ user_id，不要填昵称。
WUWA_ADMIN_USER_IDS=[]
WUWA_ENTERPRISE_USER_IDS=[]
WUWA_TRUSTED_USER_IDS=[]
WUWA_BLOCKED_USER_IDS=[]

WUWA_PERSONA_PROFILE_ID=shorekeeper
WUWA_PERSONA_DISPLAY_NAME=守岸人
WUWA_PERSONA_VERSION=local
WUWA_PERSONA_FILES=["C:/Users/LancyCelestia/Documents/AI智能体有关材料/鸣潮 AI智能体有关材料/守岸人人格设定.md","C:/Users/LancyCelestia/Documents/AI智能体有关材料/鸣潮 AI智能体有关材料/守岸人人格档案.md","C:/Users/LancyCelestia/Documents/AI智能体有关材料/鸣潮 AI智能体有关材料/守岸人.txt"]
WUWA_KNOWLEDGE_FILES=["C:/Users/LancyCelestia/Documents/AI智能体有关材料/鸣潮 AI智能体有关材料/鸣潮库街区百科v2.md"]
WUWA_KNOWLEDGE_MAX_CHUNKS=2
WUWA_KNOWLEDGE_CHUNK_CHARS=600

WUWA_TONE_MODE=private_chat
WUWA_TONE_VOICE=soft
WUWA_TONE_WARMTH=0.8
WUWA_TONE_DIRECTNESS=0.4
WUWA_TONE_MESSAGE_COUNT_LIMIT=1

WUWA_REPLY_PRIVATE_DEFAULT_MAX_MESSAGES=1
WUWA_REPLY_PRIVATE_SUPPORT_MAX_MESSAGES=2
WUWA_REPLY_PRIVATE_DEEP_HELP_MAX_MESSAGES=3
WUWA_REPLY_GROUP_MAX_MESSAGES=1
WUWA_REPLY_RISK_MAX_MESSAGES=1
WUWA_REPLY_MAX_CHARS_PER_MESSAGE=1200
WUWA_REPLY_DEFAULT_CONTEXT_BUDGET=2048
WUWA_REPLY_SUPPORT_CONTEXT_BUDGET=2560
WUWA_REPLY_DEEP_HELP_CONTEXT_BUDGET=3072
WUWA_REPLY_GROUP_CONTEXT_BUDGET=2048

WUWA_RATE_LIMIT_ENABLED=true
WUWA_RATE_LIMIT_WINDOW_SECONDS=60
WUWA_RATE_LIMIT_CHAT_GLOBAL_MAX_REQUESTS=60
WUWA_RATE_LIMIT_CHAT_SESSION_MAX_REQUESTS=6
WUWA_RATE_LIMIT_CHAT_SENDER_MAX_REQUESTS=4
WUWA_RATE_LIMIT_TARGET_MIN_INTERVAL_SECONDS=0
WUWA_RATE_LIMIT_BYPASS_ROLES=["admin"]
WUWA_RATE_LIMIT_DB_PATH=
WUWA_QUIET_HOURS_ENABLED=false
WUWA_QUIET_HOURS_START=23:00
WUWA_QUIET_HOURS_END=07:00
WUWA_QUIET_HOURS_TIMEZONE=Asia/Hong_Kong
WUWA_QUIET_HOURS_SESSION_TYPES=["group"]
WUWA_QUIET_HOURS_BYPASS_ROLES=["admin"]

WUWA_MEMORY_ENABLED=false
WUWA_MEMORY_DB_PATH=data/wuwa_memory.sqlite3
WUWA_MEMORY_MAX_ITEMS=5
WUWA_MEMORY_MAX_CHARS=1200

WUWA_HISTORY_ENABLED=false
WUWA_HISTORY_DB_PATH=data/wuwa_history.sqlite3
WUWA_HISTORY_MAX_TURNS=6
WUWA_HISTORY_MAX_CHARS=1600
WUWA_HISTORY_MAX_ITEMS=1000

WUWA_DIAGNOSTICS_ENABLED=false
WUWA_DIAGNOSTICS_DB_PATH=data/wuwa_diagnostics.sqlite3
WUWA_DIAGNOSTICS_MAX_ITEMS=100

WUWA_AUDIT_ENABLED=false
WUWA_AUDIT_DB_PATH=data/wuwa_audit.sqlite3
WUWA_AUDIT_MAX_ITEMS=1000
WUWA_RECEIPTS_ENABLED=false
WUWA_RECEIPTS_DB_PATH=data/wuwa_receipts.sqlite3
WUWA_RECEIPTS_MAX_ITEMS=1000
WUWA_SEND_QUEUE_ENABLED=false
WUWA_SEND_QUEUE_DB_PATH=data/wuwa_send_queue.sqlite3
WUWA_SEND_QUEUE_MAX_ITEMS=1000
WUWA_SEND_QUEUE_MAX_ATTEMPTS=3
WUWA_SEND_QUEUE_RETRY_BASE_SECONDS=30
WUWA_SEND_QUEUE_RETRY_MAX_SECONDS=300
WUWA_SEND_QUEUE_WORKER_ENABLED=false
WUWA_SEND_QUEUE_WORKER_INTERVAL_SECONDS=30
WUWA_SEND_QUEUE_WORKER_BATCH_SIZE=20

WUWA_EMOTION_ENABLED=true
WUWA_EMOTION_MAX_SIGNALS=4

# 时梗/时效备注：人格文件保持稳定，最近的梗与热词放这里（Markdown）。
# 小节标题可用 "## 主题 (YYYY-MM-DD)" 标注日期，过期备注会被自动过滤。
WUWA_TREND_ENABLED=false
WUWA_TREND_FILES=[]
WUWA_TREND_MAX_NOTES=5
WUWA_TREND_MAX_CHARS=500
WUWA_TREND_MAX_AGE_DAYS=14

# 对话环境信息：时间/日期/节气/节日自动注入；天气需要填经纬度并开启。
WUWA_TEMPORAL_ENABLED=true
WUWA_TIMEZONE=Asia/Hong_Kong
WUWA_WEATHER_ENABLED=false
WUWA_WEATHER_LATITUDE=22.3193
WUWA_WEATHER_LONGITUDE=114.1694
WUWA_WEATHER_CACHE_SECONDS=1800
WUWA_WEATHER_TIMEOUT_SECONDS=8
# 可选：覆盖内置节日表的 JSON 文件，格式 [["MM-DD","名称"],...]
WUWA_HOLIDAYS_FILE=

# 回复动作：允许用中文括号表达动作/神态，例如（轻轻点头）。
WUWA_PERSONA_ACTION_BRACKETS=true

# 外部抓取凭据：填 data/credentials.json（已被 git 忽略），
# 或使用 WUWA_CREDENTIAL_<ID> 环境变量。凭据不会进入日志与 prompt。
WUWA_CREDENTIALS_FILE=

WUWA_CHAT_ENABLED=true
WUWA_CHAT_PROVIDER=static
WUWA_CHAT_MODEL=static
WUWA_CHAT_API_KEY=
# 可以填写根地址 /v1，也可以填写完整 /chat/completions endpoint。
WUWA_CHAT_BASE_URL=https://api.openai.com/v1
# 建议范围：temperature 0.0-2.0，max_tokens >= 1，timeout_seconds > 0。
WUWA_CHAT_TEMPERATURE=0.7
WUWA_CHAT_MAX_TOKENS=512
WUWA_CHAT_TIMEOUT_SECONDS=30
