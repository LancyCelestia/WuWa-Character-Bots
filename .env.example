# ChatBot environment configuration
# Reorganized on 2026-08-27.
# 实况更正（ISYNC 2026-09-21）：旧头部宣称 "every active Config field is explicit" 与实测相反
# ——config.py 的 Config 共 633 字段，本文件当时只声明 519 个，缺 114 个且全仓无比对门。
# 现已上常驻门 tests/test_env_example_gate.py：双向差集（字段↔键）＋114 项存量挂账只减不增，
# 新加 bot_xxx 字段必须同时在这里补一行 BOT_XXX=，否则该门红。补录后请同步从台账摘除该键。
# Local .env may contain secrets and must never be committed. .env.example contains placeholders only.

# --- NoneBot runtime ---
# Core runtime, command prefixes, instance settings and local runtime log.
BOT_RUNTIME_ADMIN_PREFIX=/bot
BOT_RUNTIME_ALIAS_ENABLED=true
BOT_RUNTIME_DEFAULT_PERSONA=shorekeeper
BOT_RUNTIME_ENABLED=true
BOT_RUNTIME_DATA_DIR=../ChatBot_Runtime/data
BOT_RUNTIME_GROUP_COMMAND_PREFIX=/bot
BOT_RUNTIME_INSTANCE=
BOT_RUNTIME_LOG_FILE=data/runtime_events.log
BOT_RUNTIME_LOG_LEVEL=INFO
BOT_RUNTIME_LOG_MAX_BYTES=2097152
BOT_RUNTIME_PERSONA_NICKNAME=岸宝
BOT_RUNTIME_PERSONA_NICKNAMES=[]
BOT_RUNTIME_SETTINGS_DIR=data/settings
BOT_RUNTIME_SETTINGS_FILE=data/runtime_settings.json
# 控制面默认关闭；独立loopback端口，不复用NoneBot webhook。
BOT_CONTROL_PLANE_ENABLED=false
BOT_CONTROL_PLANE_HOST=127.0.0.1
BOT_CONTROL_PLANE_PORT=8742
BOT_CONTROL_PLANE_TOKEN_SHA256=
BOT_CONTROL_PLANE_SUPER_ADMIN_TOKEN_SHA256=
BOT_CONTROL_PLANE_HOST_ALLOWLIST=
BOT_CONTROL_PLANE_FEATURES_DB=data/control_plane_features.sqlite3
BOT_CONTROL_PLANE_FEATURES_FILE=data/control_plane_features.json
BOT_CONTROL_PLANE_CONFIG_DB=data/control_plane_config.sqlite3
BOT_CONTROL_PLANE_EVENTS_DB=data/control_plane_events.sqlite3
BOT_CONTROL_PLANE_WORKSPACES_DB=data/control_plane_workspaces.sqlite3
# F-1（SEAT-ATK-CP）：/api/v1/files/read 读取根白名单（逗号分隔的目录列表，可绝对可相对）。
# 缺省空＝端点 503 诚实拒绝（绝不回落进程 cwd）；只应登记真正的产物/素材目录。
# data/、logs/、webui/node_modules/ 为常驻敏感禁区，即便误登记也一律拒读。装配期快照键：改本行需重启。
BOT_CONTROL_PLANE_FILES_ROOTS=


# --- Persona and permissions ---
# Persona files, nicknames and role allow/deny lists.
# 用户称谓/性别偏好持久化库（用户显式设置或纠正，优先于一切推断）；data/ 前缀经 runtime_paths 重映射到运行时数据目录。
BOT_ADDRESSING_PREFERENCES_DB_PATH=data/addressing_preferences.sqlite3
# 管理团队身份档案（人格层【管理团队】注入）：[{qq,name,nicknames,role,note},...]；role=super|admin
BOT_ADMIN_PROFILES=[]
BOT_ADMIN_USER_IDS=[]
BOT_BLOCKED_USER_IDS=[]
BOT_EMOTION_ENABLED=true
BOT_EMOTION_MAX_SIGNALS=4
BOT_ENTERPRISE_USER_IDS=[]
BOT_PERSONA_ACTION_BRACKETS=true
BOT_PERSONA_ALT_PROFILES={}
BOT_PERSONA_AVATAR_URL=
BOT_PERSONA_DISPLAY_NAME=守岸人
# 生产人格正文唯一来源（运行时副本）。它由 personas/shorekeeper/ 源经**人工蒸馏**而来，
# 两者不是拷贝关系（逐行重合实测 0%），所以改动任何一侧都必须显式过一致性门：
#   python scripts/sync_persona_source.py --check          # 绿/跳过 0，红 1（改源不改副本=红）
#   python scripts/sync_persona_source.py --adopt --note "…人工审阅说明…"
#       --adopt 只重录审阅凭证（scripts/persona_sync_anchor.json），不拷贝、不改源、不写 Runtime。
#   部署机/CI 可加 --require-copy 让「本行声明的副本缺失」一律判红；未部署 bot 的机器上把本行
#   留空或删掉即可，门会按「未声明」跳过（--allow-missing-copy 为维护窗口的显式放行出口）。
BOT_PERSONA_FILES=["C:/Users/LancyCelestia/Documents/MyWorkspace/ChatBot/ChatBot_Runtime/data/persona/守岸人_核心人格.md"]
BOT_PERSONA_NICKNAMES=["岸宝","守岸人","第二实例","漂泊的终点","独属于我的蒙娜丽莎","小岸同学","蓝蝴蝶","花房的守护者"]
BOT_PERSONA_PROFILE_ID=shorekeeper
BOT_PERSONA_VERSION=local
# V21-PERSONA-001：人格核心注入走版本库（data/persona_versions.sqlite3，幂等 baseline 灌入+version/sha256 溯源；
# 任何故障 fail-open 回退文件直读路径）。默认 false 保守灰度=true 才启用。
BOT_PERSONA_VERSIONED_INJECTION=false
# 会话级身份记忆库（管理员设置）：每群/每私聊独立的 bot 称呼与身份标签；data/ 前缀经 runtime_paths 重映射。
BOT_SESSION_IDENTITY_DB_PATH=data/session_identity.sqlite3
# 超级管理员（权威高于 admin，人格层有专属保护规则；自动具备全部 admin 权限）
BOT_SUPER_ADMIN_USER_IDS=[]
BOT_TONE_DIRECTNESS=0.4
BOT_TONE_MESSAGE_COUNT_LIMIT=0
BOT_TONE_MODE=private_chat
BOT_TONE_VOICE=soft
BOT_TONE_WARMTH=0.8
BOT_TRUSTED_USER_IDS=[]

# --- Group policy and reply limits ---
# Zero message limits mean unlimited unless the corresponding feature documents another meaning.
# white1=normal replies plus proactive lottery; white2=only @bot or explicit commands.
BOT_GROUP_BLACK1=[]
BOT_GROUP_BLACK2=[]
BOT_GROUP_CHAT_AUTO_REPLY_ENABLED=false
BOT_GROUP_CHAT_AUTO_REPLY_PROBABILITY=0.05
# NOTE: the group-summary master switch is BOT_SHARED_GROUP_CONTEXT_ENABLED
# (see below, default false). BOT_GROUP_DIGEST_ENABLED was a dead field that no
# code read — removed 2026-09-11 so it can no longer be mistaken for the switch.
BOT_GROUP_DIGEST_LLM_ENABLED=false
BOT_GROUP_DIGEST_LLM_TTL_SECONDS=3600
BOT_GROUP_DIGEST_MAX_CHARS=800
BOT_GROUP_DIGEST_MAX_TURNS=20
BOT_GROUP_PROACTIVE_COOLDOWN_SECONDS=90
BOT_GROUP_PROACTIVE_MAX_REPLIES_PER_HOUR=6
BOT_GROUP_WHITE1=[]
BOT_GROUP_WHITE2=[]
# 中央出站防风暴闸（B4-spec §1；真身 domains/transport/sender/outbound_gate.py）：
# 聚合域一切主动投递触达发送队列的唯一入口，按序过三道门=静默顺延/每主体双滑窗限流/
# dedupe 键规范核验。总闸关闭=直通裸 submit、零判定零 store 读写=现状字节级不动；
# 存量 6 族（提醒/cookie 到期/群摘要/日常助理/校园转发/错误卡补发）只登记不迁移。
BOT_OUTBOUND_GATE_ENABLED=false
# 安静时间窗内非紧急等级顺延到窗结束（窗判定唯一事实源=BOT_QUIET_HOURS_*，闸内不自造解析）。
BOT_OUTBOUND_GATE_QUIET_DEFER_ENABLED=true
# 可穿静默的等级（产品裁定 D-2：仅 P0/P1 穿安静时间，其余顺延）。
BOT_OUTBOUND_GATE_URGENT_SEVERITIES=["P0","P1"]
# 每主体（键=target_scope:target_id）60s 与 3600s 双滑窗上限；0=该窗不生效，超限=defer(now+60s)。
# 这两枚支持热改，与入站 chat 限流 BOT_RATE_LIMIT_CHAT_* 是两个对象（旧「3/分钟·20/小时」
# 只属于未接线的日程 v2 引擎，不得用来描述现役生产）。
BOT_OUTBOUND_GATE_MAX_PER_TARGET_PER_MINUTE=2
BOT_OUTBOUND_GATE_MAX_PER_TARGET_PER_HOUR=6
# 闸自身的计数 store；相对 data/ 路径经 scripts/runtime_paths.py 重映射（铁律 6）。
# store 故障=fail-open 放行 + outbound_gate_degraded 告警，绝不因闸病丢消息。
BOT_OUTBOUND_GATE_DB_PATH=data/outbound_gate.sqlite3
# TTL（开闸 A 案第二腿）：闸的自动到期时刻，ISO-8601 字面量（例 2026-10-01T00:00:00Z，
# 裸时刻按 UTC 解释）。到期=等同总闸关掉并冒 outbound_gate_ttl_expired 告警——临时开闸
# 自己下班，不留人工回滚债。留空=无到期（缺省，行为与不设本键逐字节相同）；写了但解析
# 不出来=宁关不猜（outbound_gate_ttl_invalid，绝不因"读不懂"当成"没到期"继续放行）。
# 本行刻意留空：真值只在生产 .env，且开闸本身是管理员的显式动作。
BOT_OUTBOUND_GATE_ENABLED_UNTIL=
# 送达核验（治「谎报送达」，B4-spec §3.2 及其 §8 Amendment）：开启后 OneBot 本地摘段
# 会给 SENT 回执挂 segment_dropped_local 审计注记（日志本体无条件常开、只记类型名零正文），
# 并给发送队列 UNKNOWN 分片装确认器；一律不改 ReceiptState（改判=重投风暴）。
# SnowLuma get_msg 语义真机取证前生产不开，缺省 False=现状逐字节。
BOT_OUTBOUND_VERIFY_ENABLED=false
# SAFE-EXEC 裁定第 18 项：运行时改参数咽喉（runtime/settings.py set/reset_override）的
# 书面同意执法门总闸。开=按 domains/core/safety_exec/config_risk.py 四档执法：R0 直写但
# 必落审计流水；R1 管理员本会话确认；R2 只认超管私聊亲批的一次性同意卡（重试才生效）；
# R3 永不自动改。关=整体旁路、行为与接线前逐字节一致。装配期快照一次（本键在
# RESTART_REQUIRED_KEYS，热改不生效也不该生效——关护栏这个动作必须重启才做得到）。
# 读点唯一真身 domains/core/safety_exec/consent.py::ConsentPolicy.from_config。
BOT_SAFETYEXEC_ENABLED=true
BOT_QUIET_HOURS_BYPASS_ROLES=["admin"]
BOT_QUIET_HOURS_ENABLED=true
BOT_QUIET_HOURS_END=06:00
BOT_QUIET_HOURS_SESSION_TYPES=["group"]
BOT_QUIET_HOURS_START=00:00
BOT_QUIET_HOURS_TIMEZONE=Asia/Hong_Kong
BOT_RATE_LIMIT_BYPASS_ROLES=["admin"]
BOT_RATE_LIMIT_CHAT_GLOBAL_MAX_REQUESTS=60
BOT_RATE_LIMIT_CHAT_SENDER_MAX_REQUESTS=8
# 同一人点名回复最小间隔秒数（防刷屏；0=关闭）
BOT_RATE_LIMIT_CHAT_SENDER_MIN_INTERVAL_SECONDS=45
BOT_RATE_LIMIT_CHAT_SESSION_MAX_REQUESTS=12
BOT_RATE_LIMIT_DB_PATH=
BOT_RATE_LIMIT_ENABLED=true
# 群节奏层（2026-09-24 停摆根修波 R2 采纳：群 60 句/小时、桶容量 5、相邻至少 20 秒）。
# ⚠ 生效方式：五枚全在**装配期**读取，且**未登记进热改合并层** ⇒ 改这里＝必须重启才生效。
# ⚠ 本文件刻意不写这五行 ⇒ 生产取 config.py 缺省即为"开"；要关掉整层把 TOKENS_PER_HOUR 设 0。
BOT_RATE_LIMIT_GROUP_PACING_TOKENS_PER_HOUR=60
# 桶容量 B ＝ 开局可连发的句数（"绝不瞬间打光"这条红线的取值，T6 建议 5 起步）。
BOT_RATE_LIMIT_GROUP_PACING_BURST_CAPACITY=5
# 分钟外骨架（她自己的口径"每分钟 3 句"）。0 = 不设。
# ⚠ 与下面 20 秒间隔合起来时这一格**结构性冗余**：3×20=60 ⇒ 60 秒滚动窗内永远凑不满第 4 句，
#   真正在约束非豁免流量的一直是最小间隔。可达覆盖只在间隔被豁免或设 0 时出现。
#   见 tests/test_rate_limit_pacing.py::test_minute_cap_and_min_interval_shape_the_sustained_rate 的 docstring。
BOT_RATE_LIMIT_GROUP_PACING_MAX_PER_MINUTE=3
# 群非点名两句之间的最小间隔（秒）。0 = 不设。情绪/好感豁免**只免这类间隔、不免句数额度**。
BOT_RATE_LIMIT_GROUP_PACING_MIN_INTERVAL_SECONDS=20
# 图片/表情包/视频类**自己的**独立最小间隔（秒）：与文字并入同一个桶，另加这道更宽的间隔。
# 0 = 不设。（2026-09-24 裁定采纳 120；接线见 S-W15）
BOT_RATE_LIMIT_GROUP_VISION_MIN_INTERVAL_SECONDS=120
BOT_RATE_LIMIT_TARGET_MIN_INTERVAL_SECONDS=0
BOT_RATE_LIMIT_WINDOW_SECONDS=60
BOT_RENDER_FORWARD_MAX_NODES=0
BOT_RENDER_FORWARD_MIN_CHARS=0
BOT_RENDER_FORWARD_NODE_CHARS=900
BOT_REPLY_DEEP_HELP_CONTEXT_BUDGET=12288
BOT_REPLY_DEFAULT_CONTEXT_BUDGET=8192
BOT_REPLY_DETAIL=detail
# 永久性 per-user 回复策略（2026-09-28 用户裁定：她要长、有人嫌字多）：用户明示一次
# 「短一点/详细点」即长期生效，直到本人再次明示覆盖。优先级＝当轮明示 > 永久策略 >
# 上面这枚全局键 > 缺省档。策略只改长度与信息密度，不改动作/神态边界。
BOT_REPLY_POLICY_ENABLED=true
BOT_REPLY_POLICY_DB_PATH=data/reply_policy.sqlite3
# 同一人多号并键（2026-09-28 用户裁定「3865067623 + 1722380002 一起」）：左边的号把回复
# 偏好写到右边那把键上，一个人一行。只并「偏好存到哪个键」，**不并权限**——提权/角色/
# 同意判定一律不读本键（有锁钉死）。并键前写在旧号上的行会在首次读到主号键时前移一次。
# 改动需重启（表在 store 懒建时吃值并编进进程级缓存键）。
BOT_REPLY_POLICY_PERSON_ALIASES={"3865067623": "1722380002"}
# 默认讲法（2026-09-28 夜用户裁定「对没表过态的人：只回一段话，但要用自己的人格、世界观与
# 意象来表达，别寡淡」）：这个人**一条讲法都没明说过的**时候顶进提示词的受控码。
# 人话与码名都认（逗号/分号/顿号分隔）：文学化=literary_prose、说人话=plain_online_speech、
# 讲具体=concrete_delivery、铺意象=imagery_rich、换意象=varied_imagery。
# 🔴 三态：写成开⇒出指令；写成 off/none/关/不表态⇒整块不渲染（与今天之前逐字节同形）；
#     写成认不出的乱码⇒**也当没配**，绝不静默给全服派一份未知讲法。
# 🔴 优先级：本人明说 > 本键——谁说一句「说人话」就把默认拧掉，默认腿不许反向压人。
# 换意象那一枚另开「按人轮换意象族」，名册住 personas/<人格档>/imagery_families.txt
# （意象跟人格走；用量记在 reply_policy 库的 person_imagery_usage 表，键＝人）。
# 改动需重启（读点在 reply_policy 现读装配期 config 快照，合并层未登记本键）。
BOT_REPLY_DEFAULT_DIRECTIVES=literary_prose,imagery_rich
BOT_REPLY_GROUP_CONTEXT_BUDGET=8192
BOT_REPLY_GROUP_MAX_MESSAGES=0
BOT_REPLY_MAX_CHARS_PER_MESSAGE=0
BOT_REPLY_PRIVATE_DEEP_HELP_MAX_MESSAGES=0
BOT_REPLY_PRIVATE_DEFAULT_MAX_MESSAGES=0
BOT_REPLY_PRIVATE_SUPPORT_MAX_MESSAGES=0
BOT_REPLY_RISK_MAX_MESSAGES=0
BOT_REPLY_SUPPORT_CONTEXT_BUDGET=8192

# --- Persistence and diagnostics ---
# Empty DB/log paths intentionally select in-memory or disabled behavior where supported.
BOT_AUDIT_DB_PATH=data/wuwa_audit.sqlite3
BOT_AUDIT_ENABLED=false
BOT_AUDIT_LOG_FILE=
BOT_AUDIT_LOG_MAX_BYTES=2097152
BOT_AUDIT_MAX_ITEMS=1000
BOT_DIAGNOSTICS_DB_PATH=data/wuwa_diagnostics.sqlite3
BOT_DIAGNOSTICS_ENABLED=false
BOT_DIAGNOSTICS_MAX_ITEMS=100
BOT_HISTORY_DB_PATH=data/wuwa_history.sqlite3
BOT_HISTORY_ENABLED=false
BOT_HISTORY_MAX_CHARS=1600
BOT_HISTORY_MAX_ITEMS=1000
BOT_HISTORY_MAX_TURNS=6
BOT_MEMORY_DB_PATH=data/wuwa_memory.sqlite3
BOT_MEMORY_ENABLED=false
BOT_MEMORY_EXTRACT_ENABLED=true
BOT_MEMORY_MAX_CHARS=1200
BOT_MEMORY_MAX_ITEMS=5
# ---- 会话画像（person_profile 波；缺省关，关⇒整链给空串，绝不编造记忆）----
# 三枚的读点都在 character/person_profile.py 现读装配期快照 config、未进运行时覆盖
# 合并表 ⇒ 热 set 零生效（登记 settings.py::RESTART_REQUIRED_KEYS，改本文件+重启才变）。
# 画像只对「本人问本人」生效：requester≠subject 一律空串。
BOT_PERSON_PROFILE_ENABLED=false
BOT_PERSON_PROFILE_MAX_ITEMS=6
BOT_PERSON_PROFILE_MAX_CHARS=520
BOT_RECEIPTS_DB_PATH=data/wuwa_receipts.sqlite3
BOT_RECEIPTS_ENABLED=false
BOT_RECEIPTS_MAX_ITEMS=1000
BOT_SEND_QUEUE_DB_PATH=data/wuwa_send_queue.sqlite3
BOT_SEND_QUEUE_ENABLED=false
BOT_SEND_QUEUE_MAX_ATTEMPTS=3
BOT_SEND_QUEUE_MAX_ITEMS=1000
BOT_SEND_QUEUE_RETRY_BASE_SECONDS=30
BOT_SEND_QUEUE_RETRY_MAX_SECONDS=300
BOT_SEND_QUEUE_WORKER_BATCH_SIZE=20
BOT_SEND_QUEUE_WORKER_ENABLED=false
BOT_SEND_QUEUE_WORKER_INTERVAL_SECONDS=30
# 发送层单次请求硬超时（秒），OneBot/Telegram/邮箱发送共用；范围 (0,600]，默认 15。
# 可用 /bot runtime set BOT_TRANSPORT_TIMEOUT_SECONDS <秒> 热更新；超时不自动重发正文。
BOT_TRANSPORT_TIMEOUT_SECONDS=15

# 请求级总预算（秒）：单次聊天从上下文/视觉/工具循环/LLM 到发送共用单调 deadline；范围 (0,600]，默认 90。
# 预算耗尽后不再发起新的网络调用；群/频道保持静默，仅管理员收到安全字段告警。
BOT_REQUEST_BUDGET_SECONDS=90

# 管线能力单次执行硬超时（秒，超时改造 C1-a）：offload_capability 下放线程池后
# 到点即抛 CapabilityTimeout ⇒ 走统一诊断卡，不再"挂死到永远、既无回复也无卡"。
# 范围 (0,3600]，默认 400。要**严格大于** BOT_REQUEST_BUDGET_SECONDS，否则消费点
# （runtime/pipeline.py）自动抬到「请求预算 + 60s」并留 WARNING，不会静默抢跑。
# 池创建期读定一次 ⇒ 需重启（已登 RESTART_REQUIRED_KEYS），热 set 不生效。
BOT_PIPELINE_CAPABILITY_HARD_TIMEOUT_SECONDS=400

# --- LLM providers and routing ---
# Never put a real key inside BOT_MODEL_REGISTRY; use env:BOT_API_KEY_* references.
# tags = 思考强度档位（按模型家族）：deepseek/glm/kimi/minimax=low,high,max；
# gpt/grok=low,medium,high,xhigh；gemini=low,medium,high。默认思考强度=家族最高档。
BOT_API_KEY_AIPRC=<aiprc_api_key>
BOT_API_KEY_HCN=<hcn_api_key>
BOT_API_KEY_QIANQIANYE=<qianqianye_api_key>
BOT_API_KEY_DEEPSEEK_OFFICIAL=<deepseek_official_api_key>
BOT_API_KEY_DEEPSEEK_QIAN=<qian_relay_deepseek_api_key>
BOT_API_KEY_ZHIPU=<zhipu_bigmodel_api_key>
BOT_API_KEY_UMI_GROUP1=
BOT_API_KEY_UMI_GROUP2=
# POTCCV 中转站 key（2026-09-17 上车，2026-09-21 ISYNC 补登记——config.py 早已声明该字段但本文件漏了键）。
# 注意键名契约：必须严格是 BOT_POTCCV_API_KEY（字段 bot_potccv_api_key），**不能**写成
# BOT_API_KEY_POTCCV——注册表按 getattr(config, "bot_potccv_api_key") 取值，改名即静默取不到（config.py:954-958）。
BOT_POTCCV_API_KEY=<potccv_api_key>
BOT_CHAT_API_KEY=<real_api_key>
BOT_CHAT_BASE_URL=https://newapi.qianqianye.com/v1
BOT_CHAT_ENABLED=true
# 原生工具调用（chat 能力侧内置工具白名单）：总闸缺省**关**，读取口只认严格 true
# （写成 "false" 这类字符串按 fail-closed 判关）。唯一读取口
# domains/core/search/native_tools.py::native_tools_enabled 现读装配期快照 config、
# 未进运行时覆盖合并表 ⇒ 登记 settings.py::RESTART_REQUIRED_KEYS，改本文件+重启才生效。
BOT_CHAT_NATIVE_TOOLS_ENABLED=false
BOT_CHAT_FAST_CONTEXT_BUDGET=32768
BOT_CHAT_FAST_DISABLE_VECTOR_KNOWLEDGE=false
BOT_CHAT_FAST_EMBEDDING_TIMEOUT_SECONDS=3
BOT_CHAT_FAST_MAX_CANDIDATES=0
BOT_CHAT_FAST_MAX_TOKENS=65538
BOT_CHAT_FAST_MODE=true
BOT_CHAT_FAST_SKIP_WEB_PAGES=true
BOT_CHAT_FAST_TIMEOUT_SECONDS=40
BOT_CHAT_FAST_WEB_MAX_QUERIES=5
# 故障转移总时限（秒）：候选模型连续失败时的整体预算，防止响应拖到分钟级；0=不限。
BOT_CHAT_FAILOVER_MAX_SECONDS=120
# v21r2 R1（2026-09-17 用户裁定「永远按注册表优先级处理」）：同名模型渠道排序
# 严格按注册表 priority，价格/EWMA 只作同级 tiebreak；false=旧行为（价格优先）。
BOT_CHAT_STRICT_PRIORITY=true
# 渠道失败冷却（秒）：真实调用失败的渠道在候选队列降级到队尾的时长（不剔除）；0=关闭。
BOT_CHAT_CHANNEL_COOLDOWN_SECONDS=90
# 链预算止损（秒）：故障转移链除首跳外，剩余预算低于该值不再发起新跳；0=关闭。
BOT_CHAT_FAILOVER_MIN_HOP_SECONDS=3
# 正常聊天生成上限；命令能力使用各自的独立限制。
BOT_CHAT_MAX_TOKENS=65538
BOT_CHAT_MODEL=gpt-5.6-terra
# ---- LLM 计费账本 + 网关归因（B5 M1 / B1，2026-09-25）----
# 账本总开关。此前这枚键**没声明在 Config 上**（只以常量名住在 ledger.py 里），
# 而生产 os.environ 不含 BOT_* ⇒ 写在 .env 里也不生效——本次连同七枚归因键一起补真字段。
# 缺省 false = 不建库、不写行，与历史行为逐字节一致。
BOT_LLM_BILLING_ENABLED=false
# 网关归因：bot 侧注册表只指向 AxonHub，看不见网关内部实际选了哪条上游渠道，
# 也拿不到「缓存创建 token」与四项分项价。开启后由**账本写线程**按响应体 id
# （实测 == axonhub.requests.external_id）去网关库只读反查并回填账本列。
# 不在回复路径上：那条查询要等网络，挂在回复前面就是拿延迟换报表。
BOT_AXONHUB_ATTRIBUTION_ENABLED=false
# 只读账号（本机已建 axonhub_ro：仅 requests/request_executions/usage_logs/
# channels/models 五张表的 SELECT，写会被拒）。绝不要用网关的超级账号——
# 账本对网关库零写需求，给写权限等于把故障半径扩到生产网关。
# host/user 任一为空 ⇒ 整面不启用（fail-closed，不会"看着开了其实没连"）。
BOT_AXONHUB_DB_HOST=127.0.0.1
BOT_AXONHUB_DB_PORT=5432
BOT_AXONHUB_DB_DATABASE=axonhub
BOT_AXONHUB_DB_USER=axonhub_ro
# 真实口令只写进 .env（铁律 3），这里留空占位。
BOT_AXONHUB_DB_PASSWORD=
# 单批反查超时（秒）：到点放弃这一批并在账上标 unavailable，绝不拖慢落库。
# 三态必须可区分：unavailable＝没查成；miss＝查了但网关没有；空＝本轮没该查。
BOT_AXONHUB_ATTRIBUTION_TIMEOUT_SECONDS=3
# 协议端（SnowLuma）安装目录：诊断卡要素「协议端版本」读它自己的 package.json。
# 留空=走内置探测（C:/Software/SnowLuma）。读不到就在卡上写「未取到」——绝不拿
# nonebot-adapter-onebot（Python 侧封装）的版本顶替协议端版本，那是两个东西。
BOT_PROTOCOL_CLIENT_DIR=
# 慢回复先行回执（2026-09-23 用户裁定选项 C）：真回复照常跑、不被掐，只是超过
# DELAY_SECONDS 还没出结果时，先补一句守岸人口吻的等待短句。
# 判据两条：15 秒内出结果 ⇒ 什么都不发（事后也不补一句）；回执发出后真回复回来 ⇒
# 什么都不做（不撤回、不道歉）。文案是 25 条轮换池，见 runtime/progress_ack.py。
BOT_CHAT_PROGRESS_ACK_ENABLED=false
# 判定"慢"的阈值（秒，下限 1.0）。
BOT_CHAT_PROGRESS_ACK_DELAY_SECONDS=15
# 同一会话两次回执的最小间隔（秒）；只在回执真发成功时占用额度。
BOT_CHAT_PROGRESS_ACK_COOLDOWN_SECONDS=60
# 名单门（四键均接受 JSON 数组或逗号/分号分隔）：黑名单永远赢。
# 群聊缺省不开——白名单为空 = 群聊整面关闭，绝不猜群。
BOT_CHAT_PROGRESS_ACK_GROUP_WHITELIST=[]
BOT_CHAT_PROGRESS_ACK_GROUP_BLACKLIST=[]
# 私聊白名单为空 = 放开（与群聊刻意不对称，同 BOT_CONTENT_ROUTE_*）。
BOT_CHAT_PROGRESS_ACK_PRIVATE_WHITELIST=[]
BOT_CHAT_PROGRESS_ACK_PRIVATE_BLACKLIST=[]
# 阈值跟着网关当下快慢走（2026-09-25）。固定 15 秒在中转站一抖时必触发，误报成灾：
# 实测链上单跳 EWMA 就有 13.7 秒。开自适应后阈值 = 最慢一跳 EWMA × 倍率，
# 夹在 floor~cap 之间；测不到（健康库关/无样本）取 max(固定值, floor)——D2a 收口，不再退回固定值。
# 现算：ema 13.7s × 2.0 ≈ 27 秒才算慢——gemini 观测最长一跳 19.9 秒不再被误报。
BOT_CHAT_PROGRESS_ACK_ADAPTIVE_ENABLED=true
BOT_CHAT_PROGRESS_ACK_DELAY_FLOOR_SECONDS=30
BOT_CHAT_PROGRESS_ACK_DELAY_CAP_SECONDS=90
BOT_CHAT_PROGRESS_ACK_LATENCY_MULTIPLIER=2.0
# 折句窗口（2026-09-25 第 1 项）：一句话被逗号拆成两三条发时合成一轮、只回一次。
# 只有「本身像半句话」的那条才会等下一条（无句末标点或以逗号/顿号/连接词收尾），
# 正常完整句子零额外延迟；封顶 max_hold 秒必放行，绝不允许一直不回。
# 停口等待窗（原 BOT_CHAT_MESSAGE_COALESCING_QUIET_SECONDS）已于 2026-09-27 乙案
# 退役：唯一真身 message_merge.MERGE_WINDOW_SECONDS（3s），env 侧不再有入口。
BOT_CHAT_MESSAGE_COALESCING_ENABLED=true
BOT_CHAT_MESSAGE_COALESCING_MAX_HOLD_SECONDS=8
BOT_CHAT_MESSAGE_COALESCING_MAX_MESSAGES=6
BOT_CHAT_MESSAGE_COALESCING_MAX_CHARS=1500
# 限流补回（2026-09-25 第 2 项）：被"太密"类限流拦下的明确请求（私聊 / 群内 @ / 命令）
# 不再静默消失，而是等解禁那一刻补跑一次。旧行为是喊三声只应一次、后两声凭空不见，
# 且那两条连会话历史都没进——下一句回复根本不知道被喊过。
# 主动接话与安静时间不补（前者本就该被拦，后者补回=攒到早上集体轰炸）。
BOT_CHAT_RATE_LIMIT_REDRIVE_ENABLED=true
BOT_CHAT_RATE_LIMIT_REDRIVE_MAX_WAIT_SECONDS=180
BOT_CHAT_RATE_LIMIT_REDRIVE_MAX_ATTEMPTS=1
BOT_CHAT_PROVIDER=openai_compatible
BOT_CHAT_TEMPERATURE=0.7
# 推理强度：留空=各模型家族默认最高档；off=不发送；可选 low/medium/high/xhigh/max。
BOT_CHAT_REASONING_EFFORT=
BOT_CHAT_TIMEOUT_SECONDS=40
# 上下文钳制全局缺省（2026-09-17）：输入 128K / 输出 64K（router 层强制封顶）。
BOT_CHAT_MAX_INPUT_TOKENS=131072
BOT_CHAT_MAX_OUTPUT_TOKENS=65536
# 影子并发（hedged request）：主选 2s 后并发影子候选。2026-09-17 成本裁定
# 关闭——严格按注册表优先级串行故障转移，不再双发请求（最坏双倍 token）。
BOT_CHAT_HEDGED_REQUESTS_ENABLED=false
BOT_MODEL_AUTO_ROUTE=true
BOT_MODEL_PRESETS={"terra":"gpt-5.6-terra","luna":"gpt-5.6-luna"}
# 分时段自动切换模型：{"HH:MM-HH:MM": "预设或注册表id"}；跨零点如 "23:00-07:00":"luna"。窗口外回到自动选型。
BOT_MODEL_SCHEDULE={}
# 时段优先级分组（峰谷顺序）：days=ISO周编号(1=周一…7=周日)缺省=每天；windows缺省=全天；
# days/windows都缺省=兜底组；按列表顺序取第一个命中的组；命中组按 order 排序。
BOT_MODEL_PRIORITY_GROUPS=[{"name":"工作日高峰","days":[1,2,3,4,5],"windows":[["09:00","12:00"],["14:00","18:00"]],"order":["aiprc-terra","aiprc-sol"]},{"name":"非高峰","order":["aiprc-terra","aiprc-sol"]}]
# 每模型价格（元/每百万 token）：按调用时刻价格记账成本；未配置价格的模型不计费。
BOT_MODEL_PRICES={"deepseek-v4-pro":{"input":4.0,"output":16.0}}
# 模型注册表：id -> {model, base_url, api_key(env:引用), group, tags(思考强度档位), effort(可选覆盖), priority}
# ⚠ 遮蔽关系（T4 路③，回填本行前必读）：本键与运行时覆盖（settings 里的
# runtime_settings_<实例>.json）**同名条目**时，内容字段含 tags 一律以本键为准，
# 运行时侧 tags 只有被该条目 override_fields 显式认领「tags」才存活。
# 也就是说：在这里回填一条旧样例，会把 gemini 渠道的 `native-audio`/`native-video`/
# `native-animation` 三枚**能力标签静默抹掉**——不报错、不写日志，只是音视频与动图
# 从此改走 ASR/转写、抽帧、拼静态条。能力标签唯一在册真身 =
# plugins/bot_unified_runtime/domains/core/channel_capability_tags.py；
# 重启前置预检第 11 项 channel_tags 会按合并后的生效形态点名渠道与缺失标签。
# 生产现网本行为空（注册表全量归运行时 store），保持为空即无遮蔽。
BOT_MODEL_REGISTRY={"aiprc-terra":{"model":"gpt-5.6-terra","base_url":"https://aiprc.top/v1","api_key":"env:BOT_API_KEY_AIPRC","group":"gpt-plus","tags":["low","medium","high","xhigh"],"priority":1},"qian-ds-flash":{"model":"deepseek-v4-flash","base_url":"https://newapi.qianqianye.com/v1","api_key":"env:BOT_API_KEY_DEEPSEEK_QIAN","group":"浅梦号池促销","tags":["low","high","max"],"priority":2},"ds-official-pro":{"model":"deepseek-v4-pro","base_url":"https://api.deepseek.com/v1","api_key":"env:BOT_API_KEY_DEEPSEEK_OFFICIAL","group":"deepseek官方","tags":["low","high","max"],"priority":3},"hcn-kimi":{"model":"kimi-k3","base_url":"https://api.hcnsec.cn/v1","api_key":"env:BOT_API_KEY_HCN","group":"hcn","last_resort":true,"tags":["low","high","max"],"priority":4}}
# 用量监控：阈值提醒（单模型输出/输入 token、当日账单）+ 北京时间 13/18/23 定时报告，推送管理员。
BOT_USAGE_MONITOR_ENABLED=true
BOT_USAGE_ALERT_OUTPUT_TOKENS=5000000
BOT_USAGE_ALERT_INPUT_TOKENS=50000000
BOT_USAGE_ALERT_DAILY_COST_YUAN=10.0
BOT_USAGE_REPORT_HOURS=13,18,23
BOT_USAGE_REPORT_STATE_FILE=data/usage_report_state.json

