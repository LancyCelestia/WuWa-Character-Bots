BOT_RUNTIME_ENABLED=true
BOT_RUNTIME_DEFAULT_PERSONA=shorekeeper
# 群聊命令前缀与管理员专属指令前缀：默认 /bot（不绑定任何单一 IP；
# /wuwa 作为旧前缀别名仍然可用）。未来接入其他 IP 机器人也用它。
BOT_RUNTIME_GROUP_COMMAND_PREFIX=/bot
BOT_RUNTIME_ADMIN_PREFIX=/bot
# 机器人实例名：留空自动取人格 id（shorekeeper）；多实例（守岸人 / 艾弥斯等）设置彼此隔离。
BOT_RUNTIME_INSTANCE=
# 实例设置目录：每个实例一个 runtime_settings_<实例>.json。
BOT_RUNTIME_SETTINGS_DIR=data/settings
# 人格级昵称（随这个人格走，其他机器人实例不会共享）："/岸宝帮助"、"/守岸人状态" 等。
BOT_PERSONA_NICKNAME=岸宝
BOT_PERSONA_NICKNAMES=["岸宝","守岸人","第二实例","漂泊的终点","独属于我的蒙娜丽莎"]
BOT_RUNTIME_ALIAS_ENABLED=true
BOT_RUNTIME_SETTINGS_FILE=data/runtime_settings.json
# 公共会话记录导出接口（未来平台共享脱敏记录用）：默认关闭。
BOT_SHARED_EXPORT_ENABLED=false
BOT_SHARED_EXPORT_INCLUDE_PRIVATE=false
BOT_SHARED_EXPORT_MAX_CHARS=200

# 角色名单支持 JSON 数组、英文逗号或分号分隔；这里只放 QQ user_id，不要填昵称。
BOT_ADMIN_USER_IDS=[]
BOT_ENTERPRISE_USER_IDS=[]
BOT_TRUSTED_USER_IDS=[]
BOT_BLOCKED_USER_IDS=[]

BOT_PERSONA_PROFILE_ID=shorekeeper
BOT_PERSONA_DISPLAY_NAME=守岸人
BOT_PERSONA_VERSION=local
BOT_PERSONA_FILES=["C:/Users/LancyCelestia/Documents/AI智能体有关材料/鸣潮 AI智能体有关材料/守岸人人格设定.md","C:/Users/LancyCelestia/Documents/AI智能体有关材料/鸣潮 AI智能体有关材料/守岸人人格档案.md","C:/Users/LancyCelestia/Documents/AI智能体有关材料/鸣潮 AI智能体有关材料/守岸人.txt"]
BOT_KNOWLEDGE_FILES=["C:/Users/LancyCelestia/Documents/AI智能体有关材料/鸣潮 AI智能体有关材料/鸣潮库街区百科v2.md"]
BOT_KNOWLEDGE_MAX_CHUNKS=2
BOT_KNOWLEDGE_CHUNK_CHARS=600

BOT_TONE_MODE=private_chat
BOT_TONE_VOICE=soft
BOT_TONE_WARMTH=0.8
BOT_TONE_DIRECTNESS=0.4
BOT_TONE_MESSAGE_COUNT_LIMIT=1

BOT_REPLY_PRIVATE_DEFAULT_MAX_MESSAGES=1
BOT_REPLY_PRIVATE_SUPPORT_MAX_MESSAGES=2
BOT_REPLY_PRIVATE_DEEP_HELP_MAX_MESSAGES=3
BOT_REPLY_GROUP_MAX_MESSAGES=1
BOT_REPLY_RISK_MAX_MESSAGES=1
BOT_REPLY_MAX_CHARS_PER_MESSAGE=1200
BOT_REPLY_DEFAULT_CONTEXT_BUDGET=2048
BOT_REPLY_SUPPORT_CONTEXT_BUDGET=2560
BOT_REPLY_DEEP_HELP_CONTEXT_BUDGET=3072
BOT_REPLY_GROUP_CONTEXT_BUDGET=2048

BOT_RATE_LIMIT_ENABLED=true
BOT_RATE_LIMIT_WINDOW_SECONDS=60
BOT_RATE_LIMIT_CHAT_GLOBAL_MAX_REQUESTS=60
BOT_RATE_LIMIT_CHAT_SESSION_MAX_REQUESTS=6
BOT_RATE_LIMIT_CHAT_SENDER_MAX_REQUESTS=4
BOT_RATE_LIMIT_TARGET_MIN_INTERVAL_SECONDS=0
BOT_RATE_LIMIT_BYPASS_ROLES=["admin"]
BOT_RATE_LIMIT_DB_PATH=
BOT_QUIET_HOURS_ENABLED=false
BOT_QUIET_HOURS_START=23:00
BOT_QUIET_HOURS_END=07:00
BOT_QUIET_HOURS_TIMEZONE=Asia/Hong_Kong
BOT_QUIET_HOURS_SESSION_TYPES=["group"]
BOT_QUIET_HOURS_BYPASS_ROLES=["admin"]

BOT_MEMORY_ENABLED=false
BOT_MEMORY_DB_PATH=data/wuwa_memory.sqlite3
BOT_MEMORY_MAX_ITEMS=5
BOT_MEMORY_MAX_CHARS=1200

BOT_HISTORY_ENABLED=false
BOT_HISTORY_DB_PATH=data/wuwa_history.sqlite3
BOT_HISTORY_MAX_TURNS=6
BOT_HISTORY_MAX_CHARS=1600
BOT_HISTORY_MAX_ITEMS=1000

BOT_DIAGNOSTICS_ENABLED=false
BOT_DIAGNOSTICS_DB_PATH=data/wuwa_diagnostics.sqlite3
BOT_DIAGNOSTICS_MAX_ITEMS=100

BOT_AUDIT_ENABLED=false
BOT_AUDIT_DB_PATH=data/wuwa_audit.sqlite3
BOT_AUDIT_MAX_ITEMS=1000
BOT_RECEIPTS_ENABLED=false
BOT_RECEIPTS_DB_PATH=data/wuwa_receipts.sqlite3
BOT_RECEIPTS_MAX_ITEMS=1000
BOT_SEND_QUEUE_ENABLED=false
BOT_SEND_QUEUE_DB_PATH=data/wuwa_send_queue.sqlite3
BOT_SEND_QUEUE_MAX_ITEMS=1000
BOT_SEND_QUEUE_MAX_ATTEMPTS=3
BOT_SEND_QUEUE_RETRY_BASE_SECONDS=30
BOT_SEND_QUEUE_RETRY_MAX_SECONDS=300
BOT_SEND_QUEUE_WORKER_ENABLED=false
BOT_SEND_QUEUE_WORKER_INTERVAL_SECONDS=30
BOT_SEND_QUEUE_WORKER_BATCH_SIZE=20

BOT_EMOTION_ENABLED=true
BOT_EMOTION_MAX_SIGNALS=4

# 时梗/时效备注：人格文件保持稳定，最近的梗与热词放这里（Markdown）。
# 小节标题可用 "## 主题 (YYYY-MM-DD)" 标注日期，过期备注会被自动过滤。
BOT_TREND_ENABLED=false
BOT_TREND_FILES=[]
BOT_TREND_MAX_NOTES=5
BOT_TREND_MAX_CHARS=500
BOT_TREND_MAX_AGE_DAYS=14

# 对话环境信息：时间/日期/节气/节日自动注入；天气需要填经纬度并开启。
BOT_TEMPORAL_ENABLED=true
BOT_TIMEZONE=Asia/Hong_Kong
BOT_WEATHER_ENABLED=false
BOT_WEATHER_LATITUDE=22.3193
BOT_WEATHER_LONGITUDE=114.1694
BOT_WEATHER_CACHE_SECONDS=1800
BOT_WEATHER_TIMEOUT_SECONDS=8
# 可选：覆盖内置节日表的 JSON 文件，格式 [["MM-DD","名称"],...]
BOT_HOLIDAYS_FILE=

# 回复动作：允许用中文括号表达动作/神态，例如（轻轻点头）。
BOT_PERSONA_ACTION_BRACKETS=true

# 世界观术语表：游戏世界观、专有名词、专有地名、科研词汇。
# 文件格式：每行 "词条：解释" 或 "**词条**：解释"。
BOT_GLOSSARY_FILES=[]
BOT_GLOSSARY_MAX_ENTRIES=30
BOT_GLOSSARY_MAX_CHARS=1500

# 用户关系档案：对特定用户（sender_id）的称呼、好感度、偏好与态度。
# 格式见 character/relationship.py 注释；不填则按陌生人基线。
BOT_USER_PROFILES_FILE=

# 共享群上下文：默认关闭。开启后把群会话最近的公共投影（不含个人私密）
# 作为短时共享记忆注入回复（元宝式摘要）。
BOT_SHARED_GROUP_CONTEXT_ENABLED=false
# 群摘要参数：确定性摘要默认免费；可选 LLM 压缩（默认关闭，避免烧钱）。
BOT_GROUP_DIGEST_ENABLED=false
BOT_GROUP_DIGEST_MAX_TURNS=20
BOT_GROUP_DIGEST_MAX_CHARS=800
BOT_GROUP_DIGEST_LLM_ENABLED=false
BOT_GROUP_DIGEST_LLM_TTL_SECONDS=3600

# 按需梗搜索：默认关闭；开启后检测到"是什么梗/XX啥意思"类提问时，
# 在线搜索并只保留 B站/小红书/萌娘百科等二次元平台来源，自动过滤不适内容。
BOT_MEME_SEARCH_ENABLED=false
BOT_MEME_SEARCH_TIMEOUT_SECONDS=8
BOT_MEME_SEARCH_CACHE_SECONDS=600

# 长回复合并转发：文本超过该长度时渲染成合并转发消息（QQ 私聊/群聊），
# transport 不支持 forward 时自动降级回纯文本。
BOT_RENDER_FORWARD_MIN_CHARS=1500
BOT_RENDER_FORWARD_MAX_NODES=6
BOT_RENDER_FORWARD_NODE_CHARS=900

# 文件审计日志：JSONL 脱敏轮转（data/ 已被 git 忽略）。
BOT_AUDIT_LOG_FILE=
BOT_AUDIT_LOG_MAX_BYTES=2097152

# 外部抓取凭据：填 data/credentials.json（已被 git 忽略），
# 或使用 BOT_CREDENTIAL_<ID> 环境变量。凭据不会进入日志与 prompt。
BOT_CREDENTIALS_FILE=
# 凭据健康检查：开机/定时检查 expires_at，临近过期或失效时预警"重新登录"。
BOT_CREDENTIAL_WARN_DAYS=7
BOT_CREDENTIAL_PROBE_URLS={}
BOT_CREDENTIAL_PROBE_TIMEOUT_SECONDS=8
# NoneBot 入口的定时检查（开机即查一次，之后按小时间隔）。
BOT_CREDENTIAL_CHECK_ENABLED=false
BOT_CREDENTIAL_CHECK_INTERVAL_HOURS=6

BOT_CHAT_ENABLED=true
BOT_CHAT_PROVIDER=static
BOT_CHAT_MODEL=static
BOT_CHAT_API_KEY=
# 可以填写根地址 /v1，也可以填写完整 /chat/completions endpoint。
BOT_CHAT_BASE_URL=https://api.openai.com/v1
# 建议范围：temperature 0.0-2.0，max_tokens >= 1，timeout_seconds > 0。
BOT_CHAT_TEMPERATURE=0.7
BOT_CHAT_MAX_TOKENS=512
BOT_CHAT_TIMEOUT_SECONDS=30

# 备用人格（人格切换）：JSON 格式，weight=随机切换概率，emotions=情绪触发
# （例如 support_needed/help_seeking）。管理员可随时用 /bot runtime persona 指令切换。
BOT_PERSONA_ALT_PROFILES={}