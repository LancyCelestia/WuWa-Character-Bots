# 邮件账户须是已连接的 Mail 适配器账户（可与 BOT_MAIL_SENDER_ALIASES 搭配）。
# BOT_DISCONNECT_NOTICE_ENABLED=true 才会发送；冷却防止连接抖动刷屏。
BOT_DISCONNECT_NOTICE_ENABLED=false
BOT_DISCONNECT_NOTICE_COOLDOWN_SECONDS=600
BOT_DISCONNECT_NOTICE_MAIL_ACCOUNT=
BOT_DISCONNECT_NOTICE_MAIL_RECIPIENTS=[]
BOT_DISCONNECT_NOTICE_TELEGRAM_CHAT_IDS=[]
# Server酱（sct.ftqq.com 微信推送）：填 SendKey；PushPlus（pushplus.plus）：填 token。
# 两者任配其一即可在掉线时收到微信通知；都留空则只用 Telegram/邮件渠道。
BOT_DISCONNECT_NOTICE_SERVERCHAN_SENDKEY=
BOT_DISCONNECT_NOTICE_PUSHPLUS_TOKEN=

