BOT_GSCORE_HOST=127.0.0.1
BOT_GSCORE_MAX_RETRY=5
BOT_GSCORE_PORT=8765
BOT_GSCORE_WS_TOKEN=
BOT_SHARED_EXPORT_ENABLED=false
BOT_SHARED_EXPORT_INCLUDE_PRIVATE=false
BOT_SHARED_EXPORT_MAX_CHARS=200
BOT_SHARED_GROUP_CONTEXT_ENABLED=false
BOT_SHARE_ENABLED=false
BOT_SHARE_GROUPS=[]
BOT_SHARE_READ_ONLY=false
BOT_SUBSCRIBE_DB_PATH=data/subscriptions.sqlite3
BOT_SUBSCRIBE_CARD_ENABLED=true
BOT_SUBSCRIBE_DIGEST_HOUR=20
BOT_SUBSCRIBE_DIGEST_MINUTE=0
BOT_SUBSCRIBE_ENABLED=true
BOT_SUBSCRIBE_LIVE_POLL_SECONDS=60
BOT_SUBSCRIBE_MAX_ITEMS_PER_TICK=20
BOT_SUBSCRIBE_PLAYWRIGHT_POLL_SECONDS=1800
BOT_SUBSCRIBE_POLL_INTERVAL_SECONDS=300

# --- External credentials ---
BOT_CREDENTIALS_FILE=
BOT_CREDENTIAL_CHECK_ENABLED=false
BOT_CREDENTIAL_CHECK_INTERVAL_HOURS=6
BOT_CREDENTIAL_PROBE_TIMEOUT_SECONDS=8
BOT_CREDENTIAL_PROBE_URLS={}
BOT_CREDENTIAL_WARN_DAYS=7

# --- Telegram and email ---
# subject in MAIL_BOTS is the default subject only when a send call supplies no subject.
# QQ/Foxmail alias: authenticate once as 3958874605@qq.com; optionally send From shorekeeper@foxmail.com.
# Gmail: OAuth2 is preferred. A personal account may use a 16-character app password when available; never use the primary Google password.
# Keep arrays empty until local secrets are entered; do not paste tokens or authorization codes into chat.
BOT_MAIL_AUTO_REPLY_ENABLED=false
BOT_MAIL_BRIDGE_ENABLED=false
BOT_MAIL_BRIDGE_STATE_FILE=data/mail_bridge_state.json
BOT_MAIL_NOTIFY_PREVIEW_CHARS=280
BOT_MAIL_NOTIFY_TELEGRAM_ENABLED=true
BOT_MAIL_SENDER_ALIASES={"shorekeeper@foxmail.com":"3958874605@qq.com"}
BOT_TELEGRAM_ADMIN_CHAT_IDS=[]
BOT_TELEGRAM_ADMIN_USER_IDS=[]
MAIL_BOTS=[]
TELEGRAM_BOTS=[]
TELEGRAM_PROXY=
TELEGRAM_WEBHOOK_URL=

# --- MCP tools ---
# Optional nonebot-plugin-mcpclient settings; 0 means no cache expiry.
MCP_CACHE_TTL=3600
MCP_SERVERS={}
MCP_TOOL_TIMEOUT=30

# --- Database ---
# The ORM package is optional/not auto-loaded, but this URL is retained for explicit ORM commands and future models.
SQLALCHEMY_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@127.0.0.1:5432/chatbot

# --- Other retained settings ---
BOT_VISION_MODEL_REGISTRY={}
# 聊天图片/表情包识别：启用且注册表有可用模型（多模态，OpenAI 兼容）时才会调用。
BOT_VISION_ENABLED=false
# relay=视觉模型先转文字；direct=图片直传给 tags 含 vision/multimodal/vlm 的主模型，失败只回退一次 relay。
BOT_VISION_MODE=relay
BOT_VISION_TIMEOUT_SECONDS=20
BOT_VISION_MAX_IMAGES=2
BOT_VISION_MAX_CHARS=500
# Third-party NoneBot localstore. Keep it outside the AI source workspace.
# For this repository layout, dev.ps1 is always run from ChatBot\\, so these paths resolve to its sibling runtime folder.
LOCALSTORE_USE_CWD=false
LOCALSTORE_CACHE_DIR=../ChatBot_Runtime/cache/nonebot
LOCALSTORE_CONFIG_DIR=../ChatBot_Runtime/config
LOCALSTORE_DATA_DIR=../ChatBot_Runtime/data/nonebot

# Memory extraction shares chat routing configuration, but uses isolated call state.
BOT_MEMORY_EXTRACT_TIMEOUT_SECONDS=15
BOT_MEMORY_EXTRACT_MAX_TOKENS=200
BOT_MEMORY_EXTRACT_ERROR_COOLDOWN_SECONDS=300

# Wiki fallback entry pages (exact entry match required); [] disables this preference.
BOT_WIKI_ENTRY_PAGES=["鳴潮角色列表"]

BOT_GENERATED_FILES_DIR=data/generated_files
BOT_FILE_READ_MAX_CHARS=120000

