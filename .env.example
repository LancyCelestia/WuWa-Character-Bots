# --- Web, content and media ---
# Cookie files and downloaded media stay under ignored local data directories.
BOT_CARD_CACHE_MAX_BYTES=268435456
BOT_CARD_RENDER_BACKEND=playwright
BOT_CARD_RENDER_DIR=data/cards
BOT_CARD_ASSET_DIR=
BOT_HELP_CARD_COLOR=
BOT_CARD_RENDER_ENABLED=true
BOT_CARD_UI_SCALE=1.25
BOT_CONTENT_PARSE_ENABLED=true
BOT_CONTENT_PARSE_PLATFORMS=[]
# 解析结果视频直发：解析器给出视频直链（小红书 sns-video/Telegram 等）时
# 自动下载并以视频段随卡片发送；失败/超限静默降级为「下载：」提示。
BOT_CONTENT_VIDEO_AUTO_SEND=true
BOT_COOKIES_FILE=data/platform_cookies.txt
# S0 直连收编配置门（v21r4-b2-direct-collect-plan ④②③①）：缺省 false=旧直连
# 路径逐字节等价；true=走统一出站路径（重启生效）。
# 凭证过期每日提醒总开关：true=每日提醒照旧注册（缺省）；false=关掉整条提醒。
BOT_COOKIE_EXPIRY_REMINDER_ENABLED=true
BOT_DOWNLOAD_CACHE_MAX_AGE_DAYS=7
BOT_DOWNLOAD_CACHE_MAX_BYTES=2147483648
# 下载并发数与 aria2 委托（装有 aria2c 时自动多连接下载）
BOT_DOWNLOAD_ARIA2_ENABLED=true
BOT_DOWNLOAD_CONCURRENCY=8
BOT_DOWNLOAD_DIR=data/downloads
BOT_DOWNLOAD_MAX_BYTES=1073741824
BOT_DOWNLOAD_MAX_HEIGHT=0
BOT_DOWNLOAD_PROXY=http://127.0.0.1:7890
BOT_DOWNLOAD_TIMEOUT_SECONDS=600
BOT_FETCH_PLAYWRIGHT_ENABLED=true
BOT_FETCH_TIMEOUT_SECONDS=10
BOT_FORWARD_FETCH_TIMEOUT_SECONDS=5
BOT_MEDIA_ANALYZE_ENABLED=true
BOT_MUSIC_CACHE_MAX_BYTES=536870912
BOT_MUSIC_ENABLED=true
BOT_MUSIC_PLATFORMS=[]
BOT_NATURAL_COMMAND_ENABLED=true
BOT_PARSE_HISTORY_DB_PATH=data/parse_history.sqlite3
BOT_PARSE_HISTORY_ENABLED=true
BOT_PARSE_HISTORY_MAX_ITEMS=2000
BOT_WEB_CLASSIFIER_SHADOW_ENABLED=false
BOT_WEB_INTENT_TELEMETRY_DB_PATH=data/web_intent_telemetry.sqlite3
BOT_WEB_INTENT_TELEMETRY_ENABLED=false
BOT_WEB_INTENT_TELEMETRY_MAX_ITEMS=10000
BOT_WEB_SEARCH_ADMIN_NOTICE=false
# 链尾免 key 兜底（DuckDuckGo → Bing）：只在有 key 的供应商全部失败/未配置时接管，
# 永不抢在前面。缺省关——开启后检索面依赖公开搜索引擎 HTML，结果质量与配额不可控。
# 装配期读一次，改完要重启才生效（不是热改键）。
BOT_WEB_SEARCH_KEYFREE_FALLBACK_ENABLED=false
BOT_WEB_SEARCH_ENABLED=false
BOT_WEB_SEARCH_MAX_RESULTS=20
# 联网「行为」阈值（区别于上方只记录不决策的 TELEMETRY 遥测键）：
# 真正左右「搜不搜」的是总闸 BOT_WEB_SEARCH_ENABLED + 下面两枚，而非遥测。
# 置信度 = 查询主题词被知识库覆盖的比例；FALLBACK（本地世界观优先）类问题低于
# knowledge_threshold 才补搜，低于 confidence_floor（硬底线安全阀）无条件补搜一次。
# 默认值需以影子期遥测数据校准（先观察命中/空结果分布，再定阈值）。
BOT_WEB_SEARCH_KNOWLEDGE_THRESHOLD=0.6
BOT_WEB_SEARCH_CONFIDENCE_FLOOR=0.2
# ACG 专项竖源检索（v21r2）：Bangumi(bgm.tv 无key)/萌娘百科/B站公开搜索。
# 开启后仅当查询命中二次元意图（番剧/漫画/B站梗/二次元游戏）且未触发安全红线时
# 并发查竖源，结果按意图时效档加权（latest=带日期加权/background=权威度优先）并入【联网检索】；
# 单源失败诚实降级为空。B站无 cookie 时常见 -412 风控，属预期降级。
BOT_SEARCH_ACG_ENABLED=false
BOT_SEARCH_ACG_BANGUMI_ENABLED=true
BOT_SEARCH_ACG_MOEGIRL_ENABLED=true
BOT_SEARCH_ACG_BILIBILI_ENABLED=true
BOT_SEARCH_ACG_TIMEOUT_SECONDS=4.0
BOT_SEARCH_ACG_MAX_PER_SOURCE=3
# API search chain. Keys may be direct local values or env:VARIABLE references in runtime config.
# 每个提供器的自定义参数会透传进请求体，例如 Tavily：
# BOT_WEB_SEARCH_PROVIDER_OPTIONS={"tavily":{"search_depth":"advanced","time_range":"month"}}
# search_depth=basic|advanced 控制检索深度；time_range=day|week|month|year 过滤时效。
BOT_WEB_SEARCH_PROVIDER=tavily
BOT_WEB_SEARCH_FALLBACK_PROVIDERS=["you","langsearch"]
BOT_WEB_SEARCH_PROVIDER_OPTIONS={}
BOT_WEB_SEARCH_TAVILY_API_KEY=env:BOT_SEARCH_TAVILY_API_KEY
BOT_SEARCH_TAVILY_API_KEY=
BOT_SEARCH_YOU_API_KEY=
BOT_SEARCH_TINYFISH_API_KEY=
BOT_SEARCH_LANGSEARCH_API_KEY=
BOT_WEB_SEARCH_YOU_API_KEY=env:BOT_SEARCH_YOU_API_KEY
BOT_WEB_SEARCH_TINYFISH_API_KEY=env:BOT_SEARCH_TINYFISH_API_KEY
BOT_WEB_SEARCH_LANGSEARCH_API_KEY=env:BOT_SEARCH_LANGSEARCH_API_KEY
# Tavily 一级参数（留空不发送；provider_options 同名键优先）：
# search_depth=basic|advanced；time_range=day|week|month|year（时效过滤）
BOT_WEB_SEARCH_TAVILY_SEARCH_DEPTH=
BOT_WEB_SEARCH_TAVILY_TIME_RANGE=
# 正文抓取回退链：TinyFish fetch 优先，可开 Tavily extract 兜底（默认关，避免重复消耗额度）
BOT_WEB_SEARCH_TAVILY_EXTRACT_ENABLED=false
BOT_WEB_SEARCH_TAVILY_EXTRACT_ENDPOINT=https://api.tavily.com/extract
BOT_WEB_SEARCH_TAVILY_ENDPOINT=https://api.tavily.com/search
BOT_WEB_SEARCH_YOU_ENDPOINT=https://api.you.com/v1/search
BOT_WEB_SEARCH_TINYFISH_ENDPOINT=https://api.search.tinyfish.ai/search
BOT_WEB_SEARCH_TINYFISH_FETCH_ENDPOINT=https://api.fetch.tinyfish.ai
BOT_WEB_SEARCH_LANGSEARCH_ENDPOINT=https://api.langsearch.com/v1/web-search
BOT_WEB_SEARCH_FETCH_TIMEOUT_SECONDS=15
BOT_WEB_SEARCH_FETCH_MAX_CHARS=3000
BOT_WEB_SEARCH_TIMEOUT_SECONDS=3

# --- 掉线管理员通知（借鉴 nonebot_plugin_disconnect_notice） ---
# 掉线时 QQ 通道不可用，改走仍在线的 Telegram 管理员私聊 / 邮件桥通知；默认关闭。
# 邮件账户须是已连接的 Mail 适配器账户（可与 BOT_MAIL_SENDER_ALIASES 搭配）。
# BOT_DISCONNECT_NOTICE_ENABLED=true 才会发送；冷却防止连接抖动刷屏。
BOT_DISCONNECT_NOTICE_ENABLED=false
BOT_DISCONNECT_NOTICE_COOLDOWN_SECONDS=600
BOT_DISCONNECT_NOTICE_MAIL_ACCOUNT=
BOT_DISCONNECT_NOTICE_MAIL_RECIPIENTS=[]
BOT_DISCONNECT_NOTICE_TELEGRAM_CHAT_IDS=[]
# Server酱（sct.ftqq.com 微信推送）：填 SendKey；PushPlus（pushplus.plus）：填 token。
# 两者任配其一即可在掉线时收到微信通知；都留空则只用 Telegram/邮件渠道。
BOT_DISCONNECT_NOTICE_SERVERCHAN_SENDKEY=
BOT_DISCONNECT_NOTICE_PUSHPLUS_TOKEN=

# 外挂表情包生成插件 nonebot-plugin-memes（真在 venv 里时才能开启；默认关）
BOT_MEMES_PLUGIN_ENABLED=false

# --- 多候选点歌（借鉴 multincm 编号选择交互） ---
# 开启后：搜索存在多首同名/相近歌曲且无精确命中时，返回编号列表，
# 用户在有效期内回复『点歌 <编号>』完成二次选择；默认关=第一命中直接播放。
# 当前仅网易云提供候选（其搜索一次返回多首）。
BOT_MUSIC_CANDIDATES_ENABLED=true
BOT_MUSIC_CANDIDATES_TTL_SECONDS=300
BOT_MUSIC_CANDIDATES_LIMIT=5

# --- 入站事件幂等表（P0.4 前半） ---
# SnowLuma 重连可能重放同一事件；开启后同一事件对同一能力只处理一次。
# 键 = adapter|bot_id|message_id；不同能力互不影响；进程内 TTL，重启自然失效。
# 建议真实 SnowLuma 验收期间保持 false，验收通过后再开。
BOT_EVENT_IDEMPOTENCY_ENABLED=false
BOT_EVENT_IDEMPOTENCY_TTL_SECONDS=3600
BOT_EVENT_IDEMPOTENCY_MAX_ENTRIES=4096
# 非空=SQLite 持久化（跨重启拦截重放，如 data/event_idempotency.sqlite3）；留空=进程内表
BOT_EVENT_IDEMPOTENCY_DB_PATH=

# --- Prompt audit / preview ---
BOT_PROMPT_AUDIT_ENABLED=true
BOT_PROMPT_AUDIT_DIR=data/prompt_audit
BOT_PROMPT_AUDIT_INCLUDE_MESSAGES=true
BOT_PROMPT_AUDIT_INCLUDE_UNTRUSTED_CONTEXT=true
BOT_PROMPT_AUDIT_MAX_CHARS=12000
BOT_PROMPT_EXECUTION_MODE=execute
BOT_PROMPT_APPROVAL_DIGEST=
BOT_PROMPT_AUDIT_RETENTION_DAYS=14

# --- Meme features ---
# VLM tagging remains disabled until a valid vision model, Base URL and key are configured.
BOT_MEME_API_BASE_URL=http://127.0.0.1:2233
BOT_MEME_API_ENABLED=false
BOT_MEME_API_OUTPUT_DIR=data/memes
BOT_MEME_API_TIMEOUT_SECONDS=15
BOT_MEME_CACHE_MAX_BYTES=268435456
BOT_MEME_COMMAND_ENABLED=true
BOT_MEME_LIBRARY_COOLDOWN_SECONDS=20
BOT_MEME_LIBRARY_DB_PATH=data/meme_library.sqlite3
BOT_MEME_LIBRARY_DIR=data/meme_library
BOT_MEME_LIBRARY_ENABLED=false
BOT_MEME_LIBRARY_GROUP_ALLOWLIST=[]
BOT_MEME_LIBRARY_GROUP_DENYLIST=[]
BOT_MEME_LIBRARY_MAX_AGE_DAYS=30
BOT_MEME_LIBRARY_MAX_FILES=20000
BOT_MEME_LIBRARY_MAX_FILE_BYTES=5242880
# 收库内容守卫（B1 波，2026-09-28）：「把所有表情贴纸存下来」收窄为真贴纸——
# 字节下限（KB）+ 像素短边下限挡 1KB 图标/缩略图；任一 > 0 启用像素判定，全 0 = 关。
# 文件头魔数验真在 _download_once 常开（假图在取字节那步就按「不收」弃掉）。
BOT_MEME_LIBRARY_MIN_FILE_KB=100
BOT_MEME_LIBRARY_MIN_SIDE=300
BOT_MEME_LIBRARY_NSFW_DELETE=0.8
BOT_MEME_LIBRARY_NSFW_MAX=0.2
BOT_MEME_LIBRARY_PREFER=["守岸人","岸宝","鸣潮","战双帕弥什","库洛"]
BOT_MEME_LIBRARY_PROXY=
BOT_MEME_LIBRARY_VLM_API_KEY=
BOT_MEME_LIBRARY_VLM_BASE_URL=
BOT_MEME_LIBRARY_VLM_ENABLED=false
BOT_MEME_LIBRARY_VLM_MODEL=
BOT_MEME_LIBRARY_VLM_PRESET=
# 预设名落空时退到 BOT_VISION_MODEL_REGISTRY 里真实存在的第一组（缺省开）。
# 现网实况：上面那行被写成空、注册表里只有 myvlm 一组 ⇒ 旧实现两侧都取不到 ⇒
# 打标静默不跑、库里的图全没标签（选图就像随机）。关掉本键即逐字节回到旧行为。
BOT_MEME_LIBRARY_VLM_FALLBACK_FIRST_PRESET=true
# 自动吸收主体是守岸人的贴纸（VLM 主体判定命中 personas/shorekeeper/aliases.txt
# 里的任一别名 ⇒ 标本命、吃本命加权、默认豁免按龄裁剪）。不放宽任何收库门。
BOT_MEME_SHOREKEEPER_ABSORB_ENABLED=true
# 本命贴纸豁免「按天」那一刀（BOT_MEME_LIBRARY_MAX_AGE_DAYS）；按量上限照常。
BOT_MEME_SHOREKEEPER_PROTECT_FROM_PRUNE=true
# 相关性地板：比合格分（库权重×主题相关度）不比排序分，所以拦的只有「判非表情」
# 与「离题且不熟」两类；心情/口味/本命只排序不触地板（0.35=非表情 0.25 不发、
# 无主题信号的中性档 0.5 照发）。
BOT_MEME_RELEVANCE_MIN=0.35
# 反重复作用域：global=本机发过就不再发（缺省）；session=再并上一会话/群一本账
# （只会更严，永不更松）。同一张贴纸绝不发第二次做在选图咽喉，不开也拦不住记账。
BOT_MEME_STICKER_SCOPE_MODE=global
BOT_MEME_LIBRARY_VLM_TIMEOUT_SECONDS=20
BOT_MEME_SEARCH_CACHE_SECONDS=600
BOT_MEME_SEARCH_ENABLED=false
BOT_MEME_SEARCH_TIMEOUT_SECONDS=8

# --- Bot's own sticker pool (守岸人表情私库) ---
# 管理员自己放进登记目录的贴纸，与 BOT_MEME_LIBRARY_DIR（别人发到群里的图被收进库）
# 分家：本目录只读、不落 SQLite、不打标签、不进权重账。唯一读路径 =
# domains/meme/sources/sticker_packs.py，消费方不得自己 walk 这个目录。
# 筛子只有四道：扩展名白名单(.gif/.apng/.png/.webp/.jpg/.jpeg) + 文件头魔数验真 +
# 0 字节拒 + 越出登记根拒。**刻意没有**像素/字节下限（先例 BOT_RANDPIC_MIN_SIDE）——
# 贴纸本来就小、GIF 预览分辨率天然低，搬那把尺会把她精心挑的包裁成空池。
# data/ 前缀自动重定向到运行时数据目录；目录不存在时诚实不发（绝不自建目录）。
# 往目录里丢新包不用重启 bot：扫池清单 30 秒 TTL。
BOT_STICKER_DIR=data/bot_stickers/shorekeeper
# 人格分册（2026-09-29 用户裁定）：把 BOT_STICKER_DIR 指到按人格分册的仓库根
# （例如 data/meme_library），bot 只从「现役人格同名子目录」取图——现在＝守岸人，
# 加人格后自动跟切。子目录名优先匹配人格展示名（守岸人），回落人格 id（shorekeeper）；
# 现役人格的册不存在＝诚实不发，绝不回退基根（基根下是别人格的册与散件）。
# 册内可再按情绪建子目录（生气/开心/贴贴…），子目录名与回复情绪词互含即优先选中。
# BOT_STICKER_DIR=data/meme_library
# S4 好感档联动：册内「私藏」类子目录只对好感档 ≥ 阈值的对象解锁（8 档体系，
# 值大＝更亲近；档位读不出＝按未解锁算）。子目录名留空＝关闭该功能。
BOT_STICKER_PRIVATE_SUBDIR=私藏
BOT_STICKER_PRIVATE_MIN_TIER=7
# 发送侧总闸，P3 情绪时刻 / 戳一戳 / 偷表情 三条腿共用。与 feature gate
# bot.plugin.sticker_packs 是两道独立门（任一关就不发）。
BOT_STICKER_ENABLED=true
# 递归扫子目录（按角色/情绪分包的摆法）；false=只扫登记根那一层。
BOT_STICKER_RECURSIVE=true
# 窗内不重发同一张贴纸（按会话记账，判据=内容 SHA-256，与随机图复用同一本窗口实现）。
# 0=关（纯随机，可重样）。指令路整库都在窗内时退「最久没发」那张并记成复发，
# 主动路（P3 情绪时刻）宁可不发也不刷屏。
BOT_STICKER_NO_REPEAT_WINDOW_SECONDS=1800

# --- Time, weather and public queries ---
BOT_EPIC_ENABLED=true
BOT_HOLIDAYS_FILE=
BOT_TEMPORAL_ENABLED=true
BOT_TIMEZONE=Asia/Hong_Kong
BOT_TODAY_HISTORY_ENABLED=true
BOT_TODAY_HISTORY_PUSH_FILE=data/today_history_push.json
# 「历史上的今天」每日缓存文件；data/ 前缀会被自动重定向到运行时数据目录。
BOT_TODAY_HISTORY_CACHE_FILE=data/today_history_cache.json
BOT_WEATHER_CACHE_SECONDS=1800
BOT_WEATHER_ENABLED=false
BOT_WEATHER_LATITUDE=22.3193
BOT_WEATHER_LONGITUDE=114.1694
BOT_WEATHER_QUERY_ENABLED=true
BOT_WEATHER_TIMEOUT_SECONDS=8
BOT_WIKI_ENABLED=true
BOT_WIKI_LANG=zh
# 个股行情路由开关（英伟达/AMD/英特尔股价）
BOT_STOCKS_ENABLED=true
# 汇率路由开关
BOT_FX_ENABLED=true
# 商品（COMEX 金银铜+原油）/国债收益率/北向资金路由开关。
# 这三个键 2026-09-21 才补进 Config：补键前 base_router 一直在读不存在的名，
# 写 BOT_COMMODITIES_ENABLED=false 也不会生效（缺省 True＝与补键前行为一致）。
BOT_COMMODITIES_ENABLED=true
BOT_BOND_ENABLED=true
BOT_NORTHBOUND_ENABLED=true
# 媒体归档（bot.media_archive）：发媒体+收藏/归档 → VLM 分类落盘到本机（类别×IP 双层目录）。
# min_role 默认 super_admin（只有超管能触发）；改 user 即开放全员（每日限额照常）。
BOT_MEDIA_ARCHIVE_ENABLED=true
BOT_MEDIA_ARCHIVE_MIN_ROLE=super_admin
BOT_MEDIA_ARCHIVE_DAILY_LIMIT=50
# 外部紧急信息聚合（bot.emergency_info，帮助面仅管理员）：采集→定级→去重→审核→经中央闸按订阅投递。
# 装配门两腿（2026-09-20 裁定 3.B）：enabled ∧ sources，任一空=整链不装配（不猜源、不猜群）。
# 「哪个群/哪个人收什么条件」不在这里配——群内或私聊说「紧急信息 订阅 area=湘潭 kinds=暴雨 橙色以上」，
#   落 emergency_subscriptions 表、每轮现读、当轮生效；「订阅 看」查条件与累计命中，「退订」撤销。
# 下面两键降级为可选硬推腿（不受订阅过滤，缺省空=该腿不存在）。
# 审核名单空=审核面关闭（缺省拒绝）；权威源按 AUTO_APPROVE 名单自动过审（D-8a）。装配期快照，改后重启生效。
BOT_EMERGENCY_INFO_ENABLED=false
BOT_EMERGENCY_INFO_SOURCES=
BOT_EMERGENCY_INFO_AUTO_APPROVE_SOURCES=
BOT_EMERGENCY_INFO_POLL_INTERVAL_SECONDS=300
BOT_EMERGENCY_INFO_MIN_LEVEL=P2
# 静默窗源级穿窗表：与族级地板取交（只收窄不放宽），缺省 P0,P1 覆盖全族地板＝行为与旧现状相同。
BOT_EMERGENCY_INFO_QUIET_BREACH_LEVELS=P0,P1
BOT_EMERGENCY_INFO_PUSH_GROUP_WHITELIST=
BOT_EMERGENCY_INFO_PUSH_USER_IDS=
BOT_EMERGENCY_INFO_REVIEWER_IDS=
BOT_EMERGENCY_INFO_KEEP_DAYS=90
BOT_EMERGENCY_INFO_DB_PATH=data/emergency_info.sqlite3
# 一致性漂移巡检（domains/ops/sync_drift）：定期复算文档/配置/触发词与代码真身是否相等，
# 漂移则三通道（QQ 超管 / Telegram / 邮件）报警。总闸缺省关=连 job 都不注册（改它须重启）；
# SURFACES / MAX_EVIDENCE_LINES / SUPPRESSION_SECONDS 每轮现读，热改当轮生效。
# SURFACES 留空=扫全部已登记面；填面名必须逐字等于 registry 登记表真身，写错静默不扫。
BOT_SYNC_DRIFT_ALERT_ENABLED=false
BOT_SYNC_DRIFT_SURFACES=
BOT_SYNC_DRIFT_INTERVAL_MINUTES=60
BOT_SYNC_DRIFT_STARTUP_DELAY_SECONDS=65
BOT_SYNC_DRIFT_SUPPRESSION_SECONDS=21600
BOT_SYNC_DRIFT_QQ_BOT_ID=
BOT_SYNC_DRIFT_MAX_EVIDENCE_LINES=12
# 笔记/备忘录（bot.notes）：Markdown 笔记+待办勾选+图片收纳；「做完了」自然语言勾选。
BOT_NOTES_ENABLED=true
BOT_NOTES_MAX_PER_CHAT=200
# 联网授时（bot.timesync）：NTP 校准提醒/调度时间基准（不改系统钟；逗号分隔多服务器）。
BOT_TIME_SYNC_ENABLED=true
BOT_TIME_SYNC_SERVERS=ntp.aliyun.com,cn.ntp.org.cn,pool.ntp.org
BOT_TIME_SYNC_MAX_DRIFT_MS=1500
# ⚠ 1500 是**单源**可信上限（一家之言超此即拒收）；本机钟本来就偏超 1.5s 时走下面的
# 多源互证出口（≥2 家不同供应商、簇直径≤1.0s、每枚往返≤0.5s、中位数≤60s）突破它。
# HTTPS 授时兜底（R3 停摆批）：NTP(UDP123) 真被墙时 HEAD 取 Date 头（RFC 7231）估偏移，
# 失败链 NTP→HTTPS→多源互证→系统钟，每级一行日志；仅收 https:// 端点。
# （2026-09-29 实测本机 UDP/123 是通的：历次"NTP 全败"真凶是 NTP 腿用了 TCP 套接字，已修）。
BOT_TIME_SYNC_HTTP_ENABLED=true
# 留空=内置 https://www.baidu.com,https://www.qq.com（逗号分隔可换）。
# 2026-09-29 实测把 taobao 移出默认表：它的 Date 头自己就错（同秒并发 -62.5s，
# 生产日志 -64/-84/-89s），像边缘缓存值而不是钟。只留**不同供应商**的两枚——
# 突破 ±1.5s 单源上限走互证时，同家两台一起错会伪造出共识。
BOT_TIME_SYNC_HTTP_URL=
# 统一错误报告卡（bot.error_card）：能力异常时回诊断卡（配置/栈均脱敏）。
BOT_ERROR_CARD_ENABLED=true
BOT_ERROR_CARD_COOLDOWN_SECONDS=60
BOT_ERROR_CARD_STACK_FRAMES=8
# 渲染 Phase 2（缺省=现状；解锁建议并发 2/预算 1500ms，实测 warm P50 -64%）。
BOT_RENDER_MAX_CONCURRENCY=1
BOT_RENDER_WAIT_BUDGET_MS=0
# 表情回应（bot.reactions）：识别 QQ/TG 贴纸回应+主动贴表情（三重防刷屏门）。
BOT_REACTIONS_ENABLED=true
BOT_REACTIONS_PROBABILITY=0.2
BOT_REACTIONS_COOLDOWN_SECONDS=30
BOT_REACTIONS_MAX_PER_HOUR=20
# 贴纸回应持久化：识别事件落库+统计（90 天裁剪）；双层表情第二层=情绪时刻
# 小概率发表情包（意图匹配 VLM 情绪标签；与贴表情互斥；悲伤消息绝不发）。
BOT_REACTIONS_DB_PATH=data/reactions.sqlite3
BOT_REACTIONS_STORE_DAYS=90
BOT_REACTIONS_MEME_ENABLED=true
BOT_REACTIONS_MEME_PROBABILITY=0.15
BOT_REACTIONS_MEME_COOLDOWN_SECONDS=120
BOT_REACTIONS_MEME_DAILY_MAX=6
# 贴纸语义匹配（2026-09-28 用户裁定「报喜却发委屈/大哭，不行」）：贴之前先读 bot
# 本轮**实际下发的回复文本**，由大模型判受控情感闭集再选贴；判不了/超时 ⇒ 整轮不贴。
# 超时给 8s 的量级＝"宁可不贴也不拖慢下发"；缓存 TTL 让同轮的表情腿与表情包腿共用一次判定。
BOT_REACTIONS_SENTIMENT_ENABLED=true
BOT_REACTIONS_SENTIMENT_TIMEOUT_SECONDS=8.0
BOT_REACTIONS_SENTIMENT_CACHE_TTL_SECONDS=120
# 戳一戳 v2：回复形态 mix=固定话术/LLM 话术/表情包三选一轮换（群聊自动 @戳者）；
# 回戳缺省开；好感度=放行后小额正向（每会话每日上限防刷）。
BOT_POKE_REPLY_MODE=mix
BOT_POKE_POKE_BACK=true
BOT_POKE_AFFINITY_ENABLED=true
BOT_POKE_AFFINITY_DELTA=0.5
BOT_POKE_AFFINITY_DAILY_MAX=5.0
# 戳一戳臂矩阵（P14 波）：mix 轮换池是否扩到六臂——加 voice（语音+文本）/
# randpic（随机图）/ poke（只回戳）三臂。缺省 false=停在旧三臂逐字节不变；
# BOT_POKE_REPLY_MODE 显式写 voice/randpic/poke 不受本档影响（管理员意图优先）。
# 语音臂复用 bot.tts 那条「文本+语音」能力（要 BOT_TTS_ENABLED 与引擎在线才有声，
# 合成不成只留文本腿）；随机图臂吃 BOT_RANDPIC_DIRS（图库空则回退固定话术）。
BOT_POKE_EXTRA_ARMS_ENABLED=false
# 跟戳：群里 A 戳 B 时 bot 有概率跟着戳 B（独立冷却与每小时上限，不共用回戳账）。
BOT_POKE_FOLLOW_ENABLED=false
BOT_POKE_FOLLOW_PROBABILITY=0.2
BOT_POKE_FOLLOW_COOLDOWN_SECONDS=120
BOT_POKE_FOLLOW_MAX_PER_HOUR=4
# 回复后/主动发言后戳人：bot 把话说完（含群内主动接话、入群欢迎）后按概率戳一下
# 对方；两触发共用本族旋钮、各自独立掷骰。安静时间窗内与 blocked 名单一律不戳。
BOT_POKE_AFTER_REPLY_ENABLED=false
BOT_POKE_AFTER_REPLY_PROBABILITY=0.15
BOT_POKE_AFTER_REPLY_COOLDOWN_SECONDS=300
BOT_POKE_AFTER_REPLY_MAX_PER_HOUR=3
# 随机发图派发（P14 波）：三触发=指令（一直是既有那条）/ 回复完用户消息后 /
# 用户戳 bot 后（后者走 BOT_POKE_REPLY_MODE=randpic 或开 BOT_POKE_EXTRA_ARMS_ENABLED）。
# 缺省全关=只认指令。开态同样吃安静时间与 blocked 两道硬门。
BOT_RANDPIC_DISPATCH_ENABLED=false
BOT_RANDPIC_DISPATCH_PROBABILITY=0.1
BOT_RANDPIC_DISPATCH_COOLDOWN_SECONDS=600
BOT_RANDPIC_DISPATCH_MAX_PER_HOUR=2
# 池子内容守卫（B1 波，2026-09-28）：字节下限（KB）与像素短边下限（先例 eat.py 300）；
# 任一 > 0 即启用文件头魔数验真（假 .png/HTML 改名件不进候选），两把尺全 0 = 关 = 旧行为。
# 缺省 100 KB / 300 px：占位小图、缩略图、坏件不再被当成「图库里有货」。
BOT_RANDPIC_MIN_FILE_KB=100
BOT_RANDPIC_MIN_SIDE=300
# 窗内不重发同一张（按会话记）：0=关（旧行为，纯随机可重样）；>0 指令路与主动路
# 共用同一本窗账。指令路整库都在窗内时退「最久没发」那张（不拒不发），主动路宁可不发。
BOT_RANDPIC_NO_REPEAT_WINDOW_SECONDS=0
# R-18 内容感知路由（2026-09-17 v2）：标签注入层已删（gemini/grok 当注入攻击
# 整轮拒答）；检测=本地强词表+上下文累积+「亲密模式 开/关」（含倒装句式）；
# 命中时自动候选序按 BOT_CONTENT_ROUTE_ORDER（grok→gemini，用户裁定）并跳过
# 影子并发。擦边词不记分：普通模式可以擦边，只有强词/手动开关切 grok。
# 群聊亲密面走黑白名单制：白名单群才可开亲密模式（群内仅管理员可拨开关），
# 黑名单优先；白名单空=群聊亲密面整体关闭。私聊/控制台不受此门限制。
BOT_CONTENT_ROUTE_ENABLED=true
BOT_CONTENT_ROUTE_MODEL=grok-4.6
BOT_CONTENT_ROUTE_ORDER=grok-4.6,gemini-3.8-flash
BOT_CONTENT_ROUTE_WORDS=
BOT_CONTENT_ROUTE_INTIMATE_THRESHOLD=60
BOT_CONTENT_ROUTE_NORMAL_THRESHOLD=25
BOT_CONTENT_ROUTE_CONTEXT_TURNS=4
BOT_CONTENT_ROUTE_MAX_TTL_MINUTES=120
BOT_CONTENT_ROUTE_IDLE_RESET_MINUTES=10
BOT_CONTENT_ROUTE_GROUP_WHITELIST=[]
BOT_CONTENT_ROUTE_GROUP_BLACKLIST=[]
# v21r5 双开关+四名单（2026-09-19）：群聊两级开关——管理员「亲密模式 开」=
# 全群（开关二），成员对自己开=仅本人（开关一，BOT_CONTENT_ROUTE_GROUP_
# PER_USER_ENABLED 总闸）；两个开关同一 TTL，默认 60 分钟自动退出（按激活
# 时刻起算、活跃不续期、重开即重置；MAX_TTL=120 仍为全状态硬上限）。
BOT_CONTENT_ROUTE_INTIMATE_TTL_MINUTES=60
BOT_CONTENT_ROUTE_GROUP_PER_USER_ENABLED=true
# 私聊两面名单（语义与群面刻意不对称，注意）：私聊黑名单最高优先——Master
# Love 也压不过；私聊白名单【空=默认放开】（沿用私聊放开裁定），【非空=仅
# 名单内 QQ】。console 运营者本地面不受此门限制。
BOT_CONTENT_ROUTE_PRIVATE_WHITELIST=[]
BOT_CONTENT_ROUTE_PRIVATE_BLACKLIST=[]
# 亲密档浅档（L1）自动腿（2026-09-24 用户裁定 R1 A）：好感度达标的用户自动进
# 浅档——只给关系语气，不换模型（换模型仍只由显式「亲密模式 开」/管理员钉/内容
# 信号触发）。门槛取好感度**档号**，档号真身见 character/affinity.py 的
# _ATTITUDE_TIERS（取数口 attitude_tiers()）；+1=「亲近」那一档，调高=更严。
# ⚠ 这两枚改了要重启：合并层 _RUNTIME_HOT_OVERRIDE_FIELDS 未登记本族键，
#   /bot runtime set 会被明确拒绝（已登记 RESTART_REQUIRED_KEYS），不是"能热改"。
BOT_CONTENT_ROUTE_L1_AUTO_ENABLED=true
BOT_CONTENT_ROUTE_L1_AUTO_MIN_TIER=1
# 全球股指行情（bot.market）：东方财富 push2 免费接口，免 key，进程内 TTL 缓存。
BOT_MARKET_ENABLED=true
# 东财空响应受控重试（G2）：限流时 HTTP 200 但业务体为空（空 JSON/缺行），数据层至多重试 1 次（退避 0.6s）；关闭后与无重试逐字节一致。
BOT_MARKET_RETRY_ON_EMPTY=true
BOT_MARKET_TIMEOUT_SECONDS=6
BOT_MARKET_CACHE_SECONDS=60

# Moegirl wiki lookup: explicit command + anime entity questions
# (e.g. XX是谁?). Question misses degrade to the persona chat chain.
BOT_MOEGIRL_ENABLED=true
BOT_MOEGIRL_QUESTION_ENABLED=true
BOT_MOEGIRL_API_BASE=https://zh.moegirl.org.cn/api.php
BOT_MOEGIRL_MIRROR_API_BASE=https://mzh.moegirl.org.cn/api.php
BOT_MOEGIRL_TIMEOUT_SECONDS=5

# --- Subscriptions and integrations ---
# Subscription and Playwright settings are explicit so behavior does not silently depend on code defaults.
BOT_GSCORE_BOT_ID=NoneBot2
BOT_GSCORE_BOT_SELF_ID=
BOT_GSCORE_ENABLED=false
BOT_GSCORE_HOST=127.0.0.1
BOT_GSCORE_MAX_RETRY=5
BOT_GSCORE_PORT=8765
BOT_GSCORE_WS_TOKEN=
BOT_SHARED_EXPORT_ENABLED=false
BOT_SHARED_EXPORT_INCLUDE_PRIVATE=false
BOT_SHARED_EXPORT_MAX_CHARS=200
BOT_SHARED_GROUP_CONTEXT_ENABLED=false
BOT_SHARE_ENABLED=false
BOT_SHARE_GROUPS=[]
BOT_SHARE_READ_ONLY=false
BOT_SUBSCRIBE_DB_PATH=data/subscriptions.sqlite3
BOT_SUBSCRIBE_CARD_ENABLED=true
BOT_SUBSCRIBE_ENABLED=true
BOT_SUBSCRIBE_MAX_ITEMS_PER_TICK=20
BOT_SUBSCRIBE_POLL_INTERVAL_SECONDS=300
# 审查 J-02：订阅 per-platform 开关（默认全开=现状零变化；改后需重启生效）。
# 关=该平台订阅 add 显式拒绝、轮询跳过；键名与 V2 注册表 target.platform 一致。
BOT_SUBSCRIBE_PLATFORM_BILIBILI=true
BOT_SUBSCRIBE_PLATFORM_XIAOHONGSHU=true
BOT_SUBSCRIBE_PLATFORM_YOUTUBE=true
BOT_SUBSCRIBE_PLATFORM_TELEGRAM=true
BOT_SUBSCRIBE_PLATFORM_PIXIV=true
BOT_SUBSCRIBE_PLATFORM_WEIBO=true
BOT_SUBSCRIBE_PLATFORM_NETEASE=true
# outbox/seen 保留期与重试旋钮（subscription_store_v2.py 四枚 getattr 读点）：
# 读点走 `or` 链 ⇒ 0 恒回退模块常量，缺省 0 = 零行为变更、把这些旋钮变成真可控。
BOT_SUBSCRIPTION_OUTBOX_SENT_RETENTION_DAYS=0
BOT_SUBSCRIPTION_SEEN_RETENTION_DAYS=0
BOT_SUBSCRIPTION_OUTBOX_MAX_ATTEMPTS=0
BOT_SUBSCRIPTION_OUTBOX_SENDING_STALE_SECONDS=0

# --- External credentials ---
BOT_CREDENTIALS_FILE=
BOT_CREDENTIAL_CHECK_ENABLED=false
BOT_CREDENTIAL_CHECK_INTERVAL_HOURS=6
BOT_CREDENTIAL_PROBE_TIMEOUT_SECONDS=8
BOT_CREDENTIAL_PROBE_URLS={}
BOT_CREDENTIAL_WARN_DAYS=7

# --- Network patrol (Clash liveness + upstream dual-path probes) ---
# Disabled/short-period both require a bot restart to take effect (config snapshot at assembly stage).
# DOMAINS left empty = the built-in list of 7 upstream relay domains; to override, separate multiple domains with commas.
BOT_NETWORK_PATROL_ENABLED=true
BOT_NETWORK_PATROL_INTERVAL_MINUTES=15
BOT_NETWORK_PATROL_DOMAINS=

# --- Telegram and email ---
# subject in MAIL_BOTS is the default subject only when a send call supplies no subject.
# QQ/Foxmail alias: authenticate once as 3958874605@qq.com; optionally send From shorekeeper@foxmail.com.
# Gmail: OAuth2 is preferred. A personal account may use a 16-character app password when available; never use the primary Google password.
# Keep arrays empty until local secrets are entered; do not paste tokens or authorization codes into chat.
BOT_MAIL_AUTO_REPLY_ENABLED=false
BOT_MAIL_BRIDGE_ENABLED=false
BOT_MAIL_BRIDGE_STATE_FILE=data/mail_bridge_state.json
BOT_MAIL_NOTIFY_PREVIEW_CHARS=280
BOT_MAIL_NOTIFY_TELEGRAM_ENABLED=true
BOT_MAIL_SENDER_ALIASES={"shorekeeper@foxmail.com":"3958874605@qq.com"}
BOT_TELEGRAM_ADMIN_CHAT_IDS=[]
BOT_TELEGRAM_ADMIN_USER_IDS=[]
MAIL_BOTS=[]
TELEGRAM_BOTS=[]
TELEGRAM_PROXY=
TELEGRAM_WEBHOOK_URL=

# --- MCP tools ---
# Optional nonebot-plugin-mcpclient settings; 0 means no cache expiry.
MCP_CACHE_TTL=3600
MCP_SERVERS={}
MCP_TOOL_TIMEOUT=30

# --- Database ---
# The ORM package is optional/not auto-loaded, but this URL is retained for explicit ORM commands and future models.
SQLALCHEMY_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@127.0.0.1:5432/chatbot

# --- Other retained settings ---
BOT_VISION_MODEL_REGISTRY={}
# 聊天图片/表情包/视频识别：启用且注册表有可用模型（多模态，OpenAI 兼容）时才会调用。
# 本机落盘图片（SnowLuma file:/// 路径）直读转 base64；GIF 取首帧；视频经 ffmpeg 抽帧。
BOT_VISION_ENABLED=false
# relay=视觉模型先转文字；direct=图片直传给 tags 含 vision/multimodal/vlm 的主模型，失败只回退一次 relay。
BOT_VISION_MODE=relay
BOT_VISION_TIMEOUT_SECONDS=20
BOT_VISION_MAX_IMAGES=2
BOT_VISION_MAX_CHARS=500
BOT_VISION_VIDEO_FRAMES=4
# 图片描述缓存：同一张图（按内容 sha256 认，不按 URL 认）第二次进来直接复用上一次的
# VLM 描述，不再重复计费。空值=关闭（与加这件之前逐字节同行为）。
BOT_VISION_CAPTION_CACHE_DB=data/vision_caption_cache.sqlite3
# 描述保留秒数，默认 24 小时；0 或负数=关闭缓存。需重启才换库/改 TTL。
BOT_VISION_CAPTION_CACHE_TTL_SECONDS=86400

# 聊天语音消息转写：OpenAI 兼容 /audio/transcriptions（如 bigmodel glm-asr、whisper 系中转）。
# registry 格式同 BOT_VISION_MODEL_REGISTRY；转写文本作为不可信上下文注入聊天。
# record 段本机路径经 ffmpeg 转 16kHz mp3 后上传；失败不阻断聊天。
BOT_ASR_MODEL_REGISTRY={}
BOT_ASR_ENABLED=false
BOT_ASR_TIMEOUT_SECONDS=20
BOT_ASR_MAX_CHARS=300

# 语音合成（bot.tts）：文本 → 守岸人音色的语音消息，对接本机 GPT-SoVITS v2ProPlus
# 的 api_v2.py HTTP 接口。文本不出本机；服务未启动只会得到一句降级文案，绝不阻断出站。
# 缺省全关——语音服务需先单独启动（api_v2.py 监听 9880）。
BOT_TTS_ENABLED=false
BOT_TTS_API_URL=http://127.0.0.1:9880
# GPT-SoVITS 程序目录；BOT_TTS_REF_AUDIOS 里的相对路径以它为基准解析。
BOT_TTS_GPTSOVITS_DIR=
# 参考音频清单，每项 "路径|参考文本|语种"（后两段可省；文本留空=无参考文本模式）。
# 硬性要求 3~10 秒干声，多项时随机轮换以贴合不同语气。
# 示例：BOT_TTS_REF_AUDIOS=["refs/shorekeeper_ref_01.flac|今天的潮汐很安静。|zh"]
BOT_TTS_REF_AUDIOS=[]
# 追加触发词（与内置 说/语音/念/朗读/tts/say + 拼音词合并）。
BOT_TTS_TRIGGER_WORDS=[]
BOT_TTS_OUTPUT_DIR=data/tts_output
# 语音预设（G-2 契约层）：合成参数唯一缺省源=中央预设表 domains/media/tts_presets.py
# （含每参数出处/引擎域值/seed 策略/读法词典占位/八硬编码收编）。以下 BOT_TTS_*
# 数值键降级为管理员覆盖（env 显式值 > 预设；缺省值=预设 v1 值，零行为变更）。
# 域值=引擎 WebUI 滑杆（越界值装载期即拒）：speed 0.6~1.65 / temperature 0~1 /
# top_k 1~100 / top_p 0~1 / timeout >=1.0；0=不限语义：MAX_CHARS 与 AUTO_REPLY_MAX_CHARS
# 的 0=不按字数截断（「不限≠无界」，必过下方两枚硬顶）。
BOT_TTS_PRESET=shorekeeper
BOT_TTS_MAX_CHARS=200
# 文本硬顶（字）：超顶=拒绝合成+留痕不拆条；0=禁配无界（取内置 2000）。
BOT_TTS_HARD_MAX_CHARS=2000
# 产物字节硬顶：8 MiB≈131s（32000Hz 恒定 64,000 B/s）；超顶不入缓存不出站；0=取内置。
BOT_TTS_MAX_AUDIO_BYTES=8388608
# 产物目录磁盘配额（U-04 缓存语义，最旧先删）：缺省 0/0=不限制（字节级不变）。
BOT_TTS_CACHE_MAX_BYTES=0
BOT_TTS_CACHE_MAX_AGE_DAYS=0
BOT_TTS_TIMEOUT_SECONDS=60.0
# 语速倍率：中文建议 0.8~0.9，过快会有电音感。
BOT_TTS_SPEED_FACTOR=0.85
BOT_TTS_TEMPERATURE=0.9
BOT_TTS_TOP_K=15
BOT_TTS_TOP_P=1.0
BOT_TTS_TEXT_LANG=zh
BOT_TTS_TEXT_SPLIT_METHOD=cut5
# sha256 结果缓存（键=文本+参考音频+采样参数），同一句话不重复合成。
BOT_TTS_CACHE_ENABLED=true
# 对话自动配音：人格回复正文一并合成为语音随消息发出。scope 取 private/group/all
# （scope=礼仪维度；群面另受内容群白名单安全门约束：BOT_CONTENT_ROUTE_GROUP_WHITELIST
# 黑名单永远赢，白名单空=群面不配音）。
BOT_TTS_AUTO_REPLY_ENABLED=false
BOT_TTS_AUTO_REPLY_SCOPE=private
BOT_TTS_AUTO_REPLY_MAX_CHARS=120
# 长回复拆条：自动配音文本超过此字数时，按句末标点（次选逗号/空白，兜底硬切）
# 切成多条语音随同一条消息发出（QQ 端渲染为多个气泡）。**0=不拆**（缺省，
# 逐字节现状）。参考档：语速 0.85 时 60 秒≈150~180 字，本部署生产 .env=165。
BOT_TTS_AUTO_REPLY_SPLIT_MAX_CHARS=0
# 配音概率门（默认 10%，2026-09-25 由 5% 上调）：确定性哈希实现，同一条消息结果恒定；0=永不配音、1.0=全量。
BOT_TTS_AUTO_REPLY_PROBABILITY=0.10
# 调试/真机验收旁路：置 true 则凡过前五道门的回复一律配音（逐条听音用，日常勿开）。
BOT_TTS_AUTO_REPLY_ALWAYS=false
# G-3 配音出站路径开关（M-10/M-13 根修）：true=自动配音改走 pipeline post-review
# hook（review 批准后的正文才合成；合成失败挂 OperationalIssue 走管理员告警链）；
# false=旧能力包装路径（现状行为）。双态互斥；装配期冻结，改后需重启生效。
BOT_TTS_VOICE_HOOK_ENABLED=false

# creation 对接点的 provider 选择器（中央调度收编波 P5）：两键**缺省空=诚实未接**。
# ⚠ 登记≠可用：BOT_CREATION_IMAGE_PROVIDER 填了也仍返回 UNAVAILABLE——绘图适配器工厂
# 尚未落地（协议齐、实现缺位）。填值的唯一效果是探测转 DEGRADED 并冒「要而不得」告警，
# 让"我配了却用不了"这件事在 /bot status 与管理员告警面都看得见。装配期快照，改后重启。
# 写成生效行（而非注释）是门禁口径要求：`.env.example` 只认列 0 的 `KEY=`，注释形态不算同步证据；
# 两键留空＝与 config.py 缺省逐字同形（诚实未接），填与不填都不改变 UNAVAILABLE 这一事实。
BOT_CREATION_IMAGE_PROVIDER=
BOT_CREATION_TTS_PROVIDER=

# 视频理解（追问"这个视频里是什么"）：媒体档案库 + 抽帧/音轨/字幕 → 人格化回答。
# 总开关关闭时保持旧的抽帧摘要行为；回复机器人发的视频/用户发的视频均可追问，
# 简报按视频缓存（一个视频只分析一次）。BOT_ASR_ENABLED 现已支持运行时热改。
BOT_VIDEO_UNDERSTANDING_ENABLED=false
BOT_MEDIA_REGISTRY_PATH=data/media_registry.sqlite3
# 档案（含简报）保留天数：过期自动清理，届时追问会重新分析；文本上限另有 5000 行 FIFO。
BOT_MEDIA_REGISTRY_TTL_DAYS=7
BOT_VIDEO_MAX_FRAMES=6
BOT_VIDEO_BRIEF_DEADLINE_SECONDS=75
BOT_VIDEO_BRIEF_MAX_CHARS=1200
BOT_VIDEO_ASR_MAX_SECONDS=600
BOT_VIDEO_SKIP_ASR_WITH_SUBTITLE=true
BOT_VIDEO_NATIVE_INPUT=false
BOT_VIDEO_NATIVE_MAX_MB=20
BOT_VIDEO_PROGRESS_ACK_ENABLED=true
BOT_VIDEO_PROGRESS_ACK_COOLDOWN_SECONDS=60
BOT_VIDEO_FUZZY_FOLLOWUP=true
# 自然语言深挖（"再仔细看看这个视频/没看懂"）：重新分析（16帧+完整音频+强制ASR）。
BOT_VIDEO_DEEP_ENABLED=true
# 视频深挖冷却窗（秒）：同会话两次深挖的最小间隔。
BOT_VIDEO_DEEP_COOLDOWN_SECONDS=300
BOT_VIDEO_DEEP_FRAMES=16
BOT_VIDEO_DEEP_ASR_MAX_SECONDS=1800
BOT_VIDEO_DEEP_DEADLINE_SECONDS=150
# Third-party NoneBot localstore. Keep it outside the AI source workspace.
# For this repository layout, dev.ps1 is always run from ChatBot\\, so these paths resolve to its sibling runtime folder.
LOCALSTORE_USE_CWD=false
LOCALSTORE_CACHE_DIR=../ChatBot_Runtime/cache/nonebot
LOCALSTORE_CONFIG_DIR=../ChatBot_Runtime/config
LOCALSTORE_DATA_DIR=../ChatBot_Runtime/data/nonebot

# Memory extraction shares chat routing configuration, but uses isolated call state.
BOT_MEMORY_EXTRACT_TIMEOUT_SECONDS=15
BOT_MEMORY_EXTRACT_MAX_TOKENS=200
BOT_MEMORY_EXTRACT_ERROR_COOLDOWN_SECONDS=300
# 记忆/反思 v2 总线（WP6）：缺省全关＝逐字节旧行为；开启后反思结果落统一事实总线，
# 召回按「相关性×强度×新近−冗余」打分（治「无关旧事实照塞」「同一偏好说五次=五行」）。
BOT_MEMORY_BUS_ENABLED=false
# bus=写新总线 / legacy=只写旧 reflection_facts（回退位）。
BOT_MEMORY_REFLECTED_WRITE_TARGET=legacy
BOT_MEMORY_STRENGTH_K=3.0
BOT_MEMORY_TAU_STABLE_DAYS=180
BOT_MEMORY_TAU_SEASONAL_DAYS=45
BOT_MEMORY_TAU_EPISODIC_DAYS=14
# 召回打分权重：JSON 文本，如 {"w_rel":1.0,"w_str":0.6,"w_rec":0.4,"w_red":0.8}；留空=按代码缺省。
BOT_MEMORY_RELEVANCE_WEIGHTS=
BOT_MEMORY_PER_CATEGORY_MAX=1
BOT_MEMORY_SEMANTIC_RECALL_ENABLED=true
# 好感度 v7（WP7）：关闭时保持 v5/v6 现行为；开启后分数走 tanh 饱和域（结构上永不触顶），
# 单句加分按「质量×新鲜度×节奏×心情×印象」缩放——敷衍短句几乎不动，重度用户不再碾压轻度用户。
BOT_AFFINITY_V7_ENABLED=false
BOT_AFFINITY_BASE_STEP=0.10
BOT_AFFINITY_NOVELTY_RATIO=0.90
BOT_AFFINITY_NOVELTY_HALO_DAYS=21
BOT_AFFINITY_RHYTHM_REFERENCE_TURNS=8
BOT_AFFINITY_NEGATIVE_EVENT_CAP_Z=0.10
BOT_AFFINITY_DAILY_MOVE_CAP_Z=0.12
BOT_AFFINITY_FUSE_DAILY_EVENTS=25
BOT_AFFINITY_REPAIR_GAIN=1.4
BOT_AFFINITY_Z_HARD_BOUND=0.985
# 质量分五子权重 / 衰减时间常数：JSON 文本，留空=按代码缺省（非法 JSON 会点名告警，不静默猜）。
BOT_AFFINITY_QUALITY_WEIGHTS=
BOT_AFFINITY_DECAY_TAU_DAYS=

# Wiki fallback entry pages (exact entry match required); [] disables this preference.
BOT_WIKI_ENTRY_PAGES=["鳴潮角色列表"]

BOT_GENERATED_FILES_DIR=data/generated_files
BOT_FILE_READ_MAX_CHARS=120000

# 文件写盘口（需求 16(2)，S-FILES-LAND 2026-09-26）：创建/修改文件的唯一落盘口
# restricted_runner 的六枚判据键。缺省逐字节=运行器内建缺省 ⇒ 现网零变更；保守在
# 口本身（白名单空=什么都不许写、可执行扩展名永远拦）。唯一读点在 file_exchange.py
# 装配函数、收的是装配期快照 ⇒ 六枚全在 RESTART_REQUIRED_KEYS，改本文件+重启才生效。
# 目录名可能含逗号，BOT_FILES_WRITE_ALLOWED_DIRS 只按 ";" / JSON 数组切（走 _parse_file_list）。
BOT_FILES_WRITE_ENABLED=true
# 空=回落 bot_download_dir/export（今日导出腿唯一落点）。填歪到禁触区仍会被运行器拦。
BOT_FILES_WRITE_ALLOWED_DIRS=
BOT_FILES_WRITE_MAX_BYTES=8388608
BOT_FILES_WRITE_DAILY_CREATE=60
BOT_FILES_WRITE_DAILY_REPLACE=120
BOT_FILES_READ_CONFINED_MAX_BYTES=8388608


# 多候选点歌：同名歧义返回编号列表，回复「点歌 <编号>」完成二次选择
BOT_MUSIC_CANDIDATES_LIMIT=6

# 视频字幕 LLM 总结（每条 B站/油管解析多一次模型调用，走主路由故障转移链）
BOT_PARSE_SUBTITLE_SUMMARY=true

# 占卜运势 HTTP 面签名密钥（opt-in）：留空 = 运势面不启用（与 Config 缺省 "" 同）。
# 要启用就在 .env 里填真实密钥（或 env:变量名 引用），本示例文件绝不放任何真实密钥。
BOT_DIVINATION_FORTUNE_SECRET=

# 模型渠道健康巡检：每小时全渠道最小调用探测（费用极低），
# 暂不可用渠道自动移出故障转移队列，30 分钟重探恢复即回队；永不自动删除。
BOT_CHANNEL_HEALTH_ENABLED=true
BOT_CHANNEL_HEALTH_INTERVAL_SECONDS=3600

# —— 日常助理（收件箱速记/早晚简报/到点吃什么）——
# 收件箱/菜单/任务清单纯文本目录（inbox.md/food.md/tasks.md，可指向工作区外共享目录）
BOT_DAILY_ASSIST_DIR=data/daily_assist
# 早晚简报与吃什么推荐的私聊推送名单（JSON 数组或逗号分隔）；空=只记不推
BOT_DAILY_ASSIST_PUSH_USER_IDS=[]
# 到点吃什么推荐时刻表（JSON 数组）
BOT_DAILY_ASSIST_MEAL_TIMES=["11:15", "17:15"]
# 早报/晚报时刻（HH:MM）
BOT_DAILY_ASSIST_MORNING_TIME=09:00
BOT_DAILY_ASSIST_EVENING_TIME=21:00

# —— V2.1 S8：教导知识库 + 数据库安全查询代理（装配=runtime/service_wiring.py，
# 受下方 B2① 主门约束：主门缺省关时以下分门不生效）——
# 教导知识库：用户提议→管理员审核→生效为「背景知识」注入（仅供理解、禁止
# 复述；结构上不可达人格/权限/路由面）。库文件走 runtime_paths 重映射。
BOT_TEACHING_ENABLED=true
BOT_TEACHING_DB_PATH=data/teaching_knowledge.sqlite3
# 数据库安全查询代理：仅注册 query_id 的参数化只读查询（白名单 registry，
# 参数 schema 绑定，单查询 2s 超时/200 行限额；禁任意表/排序/SQL 拼接）。
BOT_DATABASE_BROKER_ENABLED=true

# —— V2.1 B2① 服务装配组主门（WORLD/KB/DB/TEACH 四服务装配+注册表，
# runtime/service_wiring.py；缺省关=零装配零副作用，不改现网行为）——
BOT_V21_SERVICE_WIRING_ENABLED=false
# 世界书服务分门（worldbook_service.py：悬空/循环引用+Token 预算+草稿隔离）
BOT_WORLDBOOK_ENABLED=false
# 知识检索服务分门（knowledge_service.py：FTS/向量/RRF 三通道+原子重建）
BOT_KNOWLEDGE_SERVICE_ENABLED=false

# —— V2.1 S11：全场景日程服务面（未接线，装配属后续席位；三开关缺省关）——
# LLM 草稿解析（自然语言→结构草稿，缺信息只澄清禁猜）+课表截图识别（缺学期/节次表
# 不发布）+到点投递（occurrence→SendQueue 提交面；真实出站端口未授权前不出站）。
BOT_SCHEDULE_ENABLED=false
# 日程引擎库（与既有 schedule_service 族共库；走 runtime_paths 重映射）
BOT_SCHEDULE_DB_PATH=data/schedules_v21.sqlite3
BOT_SCHEDULE_LLM_DRAFT_ENABLED=false
BOT_SCHEDULE_TIMETABLE_ENABLED=false
BOT_SCHEDULE_DELIVERY_ENABLED=false
BOT_SCHEDULE_DELIVERY_MAX_RETRIES=3
# 第 20 项「日程记录与智能代答」（2026-09-26）：两枚新闸都缺省关、都要重启生效。
# 代答腿总闸——开着时别人问「她在干嘛」，只按分级表投影她显式标公开的条目
# （隐私判定在出站前、零 LLM；分级表见 docs/design/schedule-board-and-proxy-reply.md §5）。
BOT_SCHEDULE_STATUS_REPLY_ENABLED=false
# 宽口径自然捕捉闸——开着才把「明天8点有课」这类带时间+活动词的短句记进日程板
# （缺省隐私）；关着只认「日程/课表」显式命令与导入。
BOT_SCHEDULE_NATURAL_CAPTURE_ENABLED=false
# 调休/节假日例外表 overlay（JSON；年份不在表=unknown 不猜，绝不当作节假日宣称）
BOT_SCHEDULE_EXCEPTIONS_PATH=data/schedule_exceptions.json
