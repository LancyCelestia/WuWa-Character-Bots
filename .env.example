BOT_EMBEDDING_LOCAL_ENABLED=true
BOT_EMBEDDING_LOCAL_MODELS=bge-m3
BOT_EMBEDDING_LOCAL_TIMEOUT_SECONDS=60
BOT_EMBEDDING_MODEL=
BOT_EMBEDDING_TIMEOUT_SECONDS=30
BOT_GLOSSARY_FILES=[]
BOT_GLOSSARY_MAX_CHARS=1500
BOT_GLOSSARY_MAX_ENTRIES=30
BOT_KNOWLEDGE_CHUNK_CHARS=600
BOT_KNOWLEDGE_DB_PATH=data/knowledge_embeddings.sqlite3
BOT_KNOWLEDGE_FILES=["C:/Users/LancyCelestia/Documents/Documents/AI提示词与人格/AI智能体有关材料/鸣潮 AI智能体有关材料/鸣潮库街区百科.md","C:/Users/LancyCelestia/Documents/Documents/AI提示词与人格/AI智能体有关材料/鸣潮 AI智能体有关材料/战双帕弥什库街区百科.md","C:/Users/LancyCelestia/Documents/MyWorkspace/ChatBot/ChatBot/personas/shorekeeper/knowledge/守岸人_核心知识.md","C:/Users/LancyCelestia/Documents/MyWorkspace/ChatBot/ChatBot/personas/shorekeeper/knowledge/守岸人_人格与表达规范.md"]
BOT_KNOWLEDGE_MAX_CHUNKS=2
BOT_KNOWLEDGE_TOP_K=5
# --- Crawl Wiki knowledge base (RAG, Ollama bge-m3) ---
# Standalone vector store synced hash-idempotently from BOT_KB_WIKI_ROOT
# (docs/KB_HANDOFF.md protocol). First ingest: dev.ps1 -Task kb-sync -KbFull.
BOT_KB_WIKI_ENABLED=false
BOT_KB_WIKI_ROOT=D:\Coding\Crawl Wiki
BOT_KB_WIKI_DB_PATH=data/kb_wiki_embeddings.sqlite3
BOT_KB_WIKI_TOPICS=
BOT_KB_WIKI_TOP_K=4
BOT_KB_WIKI_CHUNK_CHARS=800
# Embed batch size; 128 measured fastest on local Ollama (~6x of 10).
BOT_KB_WIKI_EMBED_BATCH=128
