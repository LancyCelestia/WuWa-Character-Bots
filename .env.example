BOT_MUSIC_CANDIDATES_ENABLED=true
BOT_MUSIC_CANDIDATES_TTL_SECONDS=300
BOT_MUSIC_CANDIDATES_LIMIT=5

# --- 入站事件幂等表（P0.4 前半） ---
# SnowLuma 重连可能重放同一事件；开启后同一事件对同一能力只处理一次。
# 键 = adapter|bot_id|message_id；不同能力互不影响；进程内 TTL，重启自然失效。
# 建议真实 SnowLuma 验收期间保持 false，验收通过后再开。
BOT_EVENT_IDEMPOTENCY_ENABLED=false
BOT_EVENT_IDEMPOTENCY_TTL_SECONDS=3600
BOT_EVENT_IDEMPOTENCY_MAX_ENTRIES=4096
# 非空=SQLite 持久化（跨重启拦截重放，如 data/event_idempotency.sqlite3）；留空=进程内表
BOT_EVENT_IDEMPOTENCY_DB_PATH=

