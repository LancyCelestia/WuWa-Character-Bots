# ACG 专项竖源检索（v21r2）：Bangumi(bgm.tv 无key)/萌娘百科/B站公开搜索。
# 开启后仅当查询命中二次元意图（番剧/漫画/B站梗/二次元游戏）且未触发安全红线时
# 并发查竖源，结果按意图时效档加权（latest=带日期加权/background=权威度优先）并入【联网检索】；
# 单源失败诚实降级为空。B站无 cookie 时常见 -412 风控，属预期降级。
BOT_SEARCH_ACG_ENABLED=false
