BOT_RUNTIME_ENABLED=true
BOT_RUNTIME_DEFAULT_PERSONA=shorekeeper
# 群聊命令前缀与管理员专属指令前缀：默认 /bot（不绑定任何单一 IP；
# /wuwa 作为旧前缀别名仍然可用）。未来接入其他 IP 机器人也用它。
BOT_RUNTIME_GROUP_COMMAND_PREFIX=/bot
BOT_RUNTIME_ADMIN_PREFIX=/bot
# 机器人实例名：留空自动取人格 id（shorekeeper）；多实例（守岸人 / 艾弥斯等）设置彼此隔离。
BOT_RUNTIME_INSTANCE=
# 实例设置目录：每个实例一个 runtime_settings_<实例>.json。
BOT_RUNTIME_SETTINGS_DIR=data/settings
# 人格级昵称（随这个人格走，其他机器人实例不会共享）："/岸宝帮助"、"/守岸人状态" 等。
BOT_PERSONA_NICKNAME=岸宝
BOT_PERSONA_NICKNAMES=["岸宝","守岸人","第二实例","漂泊的终点","独属于我的蒙娜丽莎","小岸同学","蓝蝴蝶","花房的守护者"]
BOT_RUNTIME_ALIAS_ENABLED=true
BOT_RUNTIME_SETTINGS_FILE=data/runtime_settings.json
# 公共会话记录导出接口（未来平台共享脱敏记录用）：默认关闭。
BOT_SHARED_EXPORT_ENABLED=false
BOT_SHARED_EXPORT_INCLUDE_PRIVATE=false
BOT_SHARED_EXPORT_MAX_CHARS=200

# 角色名单支持 JSON 数组、英文逗号或分号分隔；这里只放 QQ user_id，不要填昵称。
BOT_ADMIN_USER_IDS=[]
BOT_ENTERPRISE_USER_IDS=[]
BOT_TRUSTED_USER_IDS=[]
BOT_BLOCKED_USER_IDS=[]

BOT_PERSONA_PROFILE_ID=shorekeeper
BOT_PERSONA_DISPLAY_NAME=守岸人
BOT_PERSONA_VERSION=local
BOT_PERSONA_FILES=["C:/Users/LancyCelestia/Documents/AI智能体有关材料/鸣潮 AI智能体有关材料/守岸人档案.md","C:/Users/LancyCelestia/Documents/AI智能体有关材料/鸣潮 AI智能体有关材料/守岸人人格档案.md","C:/Users/LancyCelestia/Documents/AI智能体有关材料/鸣潮 AI智能体有关材料/守岸人人格设定.md"]
BOT_KNOWLEDGE_FILES=[]
BOT_KNOWLEDGE_MAX_CHUNKS=2
BOT_KNOWLEDGE_CHUNK_CHARS=600

BOT_TONE_MODE=private_chat
BOT_TONE_VOICE=soft
BOT_TONE_WARMTH=0.8
BOT_TONE_DIRECTNESS=0.4
BOT_TONE_MESSAGE_COUNT_LIMIT=0

# 回复条数/单条长度：0 = 不限制，完整回复一次性发出（不再追加截断提示）。
BOT_REPLY_PRIVATE_DEFAULT_MAX_MESSAGES=0
BOT_REPLY_PRIVATE_SUPPORT_MAX_MESSAGES=0
BOT_REPLY_PRIVATE_DEEP_HELP_MAX_MESSAGES=0
BOT_REPLY_GROUP_MAX_MESSAGES=0
BOT_REPLY_RISK_MAX_MESSAGES=0
BOT_REPLY_MAX_CHARS_PER_MESSAGE=0
BOT_REPLY_DEFAULT_CONTEXT_BUDGET=8192
BOT_REPLY_SUPPORT_CONTEXT_BUDGET=8192
BOT_REPLY_DEEP_HELP_CONTEXT_BUDGET=12288
BOT_REPLY_GROUP_CONTEXT_BUDGET=8192

BOT_RATE_LIMIT_ENABLED=true
BOT_RATE_LIMIT_WINDOW_SECONDS=60
BOT_RATE_LIMIT_CHAT_GLOBAL_MAX_REQUESTS=60
BOT_RATE_LIMIT_CHAT_SESSION_MAX_REQUESTS=12
BOT_RATE_LIMIT_CHAT_SENDER_MAX_REQUESTS=8
BOT_RATE_LIMIT_TARGET_MIN_INTERVAL_SECONDS=0
BOT_RATE_LIMIT_BYPASS_ROLES=["admin"]
BOT_RATE_LIMIT_DB_PATH=
BOT_QUIET_HOURS_ENABLED=false
BOT_QUIET_HOURS_START=23:00
BOT_QUIET_HOURS_END=07:00
BOT_QUIET_HOURS_TIMEZONE=Asia/Hong_Kong
BOT_QUIET_HOURS_SESSION_TYPES=["group"]
BOT_QUIET_HOURS_BYPASS_ROLES=["admin"]

BOT_MEMORY_ENABLED=false
BOT_MEMORY_DB_PATH=data/wuwa_memory.sqlite3
BOT_MEMORY_MAX_ITEMS=5
BOT_MEMORY_MAX_CHARS=1200

BOT_HISTORY_ENABLED=false
BOT_HISTORY_DB_PATH=data/wuwa_history.sqlite3
BOT_HISTORY_MAX_TURNS=6
BOT_HISTORY_MAX_CHARS=1600
BOT_HISTORY_MAX_ITEMS=1000

BOT_DIAGNOSTICS_ENABLED=false
BOT_DIAGNOSTICS_DB_PATH=data/wuwa_diagnostics.sqlite3
BOT_DIAGNOSTICS_MAX_ITEMS=100

BOT_AUDIT_ENABLED=false
BOT_AUDIT_DB_PATH=data/wuwa_audit.sqlite3
BOT_AUDIT_MAX_ITEMS=1000
BOT_RECEIPTS_ENABLED=false
BOT_RECEIPTS_DB_PATH=data/wuwa_receipts.sqlite3
BOT_RECEIPTS_MAX_ITEMS=1000
BOT_SEND_QUEUE_ENABLED=false
BOT_SEND_QUEUE_DB_PATH=data/wuwa_send_queue.sqlite3
BOT_SEND_QUEUE_MAX_ITEMS=1000
BOT_SEND_QUEUE_MAX_ATTEMPTS=3
BOT_SEND_QUEUE_RETRY_BASE_SECONDS=30
BOT_SEND_QUEUE_RETRY_MAX_SECONDS=300
BOT_SEND_QUEUE_WORKER_ENABLED=false
BOT_SEND_QUEUE_WORKER_INTERVAL_SECONDS=30
BOT_SEND_QUEUE_WORKER_BATCH_SIZE=20

BOT_EMOTION_ENABLED=true
BOT_EMOTION_MAX_SIGNALS=4

# 时梗/时效备注：人格文件保持稳定，最近的梗与热词放这里（Markdown）。
# 小节标题可用 "## 主题 (YYYY-MM-DD)" 标注日期，过期备注会被自动过滤。
BOT_TREND_ENABLED=false
BOT_TREND_FILES=[]
BOT_TREND_MAX_NOTES=5
BOT_TREND_MAX_CHARS=500
BOT_TREND_MAX_AGE_DAYS=14

# 对话环境信息：时间/日期/节气/节日自动注入；天气需要填经纬度并开启。
BOT_TEMPORAL_ENABLED=true
BOT_TIMEZONE=Asia/Hong_Kong
BOT_WEATHER_ENABLED=false
BOT_WEATHER_LATITUDE=22.3193
BOT_WEATHER_LONGITUDE=114.1694
BOT_WEATHER_CACHE_SECONDS=1800
BOT_WEATHER_TIMEOUT_SECONDS=8
# 可选：覆盖内置节日表的 JSON 文件，格式 [["MM-DD","名称"],...]
BOT_HOLIDAYS_FILE=

# 回复动作：允许用中文括号表达动作/神态，例如（轻轻点头）。
BOT_PERSONA_ACTION_BRACKETS=true

# 世界观术语表：游戏世界观、专有名词、专有地名、科研词汇。
# 文件格式：每行 "词条：解释" 或 "**词条**：解释"。
BOT_GLOSSARY_FILES=[]
BOT_GLOSSARY_MAX_ENTRIES=30
BOT_GLOSSARY_MAX_CHARS=1500

# 用户关系档案：对特定用户（sender_id）的称呼、好感度、偏好与态度。
# 格式见 character/relationship.py 注释；不填则按陌生人基线。
BOT_USER_PROFILES_FILE=

# 共享群上下文：默认关闭。开启后把群会话最近的公共投影（不含个人私密）
# 作为短时共享记忆注入回复（元宝式摘要）。
BOT_SHARED_GROUP_CONTEXT_ENABLED=false
# 群摘要参数：确定性摘要默认免费；可选 LLM 压缩（默认关闭，避免烧钱）。
BOT_GROUP_DIGEST_ENABLED=false
BOT_GROUP_DIGEST_MAX_TURNS=20
BOT_GROUP_DIGEST_MAX_CHARS=800
BOT_GROUP_DIGEST_LLM_ENABLED=false
BOT_GROUP_DIGEST_LLM_TTL_SECONDS=3600

# 按需梗搜索：默认关闭；开启后检测到"是什么梗/XX啥意思"类提问时，
# 在线搜索并只保留 B站/小红书/萌娘百科等二次元平台来源，自动过滤不适内容。
BOT_MEME_SEARCH_ENABLED=false
BOT_MEME_SEARCH_TIMEOUT_SECONDS=8
BOT_MEME_SEARCH_CACHE_SECONDS=600
# 表情包生成（bot.meme）：对接本地 meme-generator-rs（MIT，默认 127.0.0.1:2233）。
# 先启动 meme-generator-rs 再开 BOT_MEME_API_ENABLED=true；命令：/表情 列表、/表情 <key> <文字>。
BOT_MEME_COMMAND_ENABLED=true
BOT_MEME_API_ENABLED=false
BOT_MEME_API_BASE_URL=http://127.0.0.1:2233
BOT_MEME_API_TIMEOUT_SECONDS=15
BOT_MEME_API_OUTPUT_DIR=data/memes
# 自然语言命令层（基层路由优先级 45）：“帮我查天气”“来首歌”等归一化执行对应插件。
BOT_NATURAL_COMMAND_ENABLED=true
# 群聊自动接话：true 时对未点名群消息按概率做确定性哈希抽签回复；默认关闭不扰民。
BOT_GROUP_CHAT_AUTO_REPLY_ENABLED=false
BOT_GROUP_CHAT_AUTO_REPLY_PROBABILITY=0.0


# 链接解析（bot.content）：消息里出现支持平台的链接时自动解析成信息卡。
# 支持：bilibili,douyin,xiaohongshu,youtube,twitter,xiaoheihe,miyoushe,
#       skland,kurobbs,netease_music,qqmusic,kuwo,kugou,apple_music,spotify
BOT_CONTENT_PARSE_ENABLED=true
# 平台白名单（空=全部），例：["bilibili","netease_music"]
BOT_CONTENT_PARSE_PLATFORMS=[]
# 点歌（bot.music）：『点歌 <歌名>』按顺序搜索：网易云 → Apple → 酷狗 → QQ → 酷我。
BOT_MUSIC_ENABLED=true
# 点歌搜索顺序白名单（空=默认顺序）
BOT_MUSIC_PLATFORMS=[]
# 解析/点歌统一超时（秒）
BOT_FETCH_TIMEOUT_SECONDS=10
# 平台 Cookie 文件（Netscape 格式，浏览器"Cookies.txt"扩展导出）。
# 用于：B站(受限视频)、小红书(正文/图集深解析)、抖音(标题/封面深解析)、
#       QQ音乐(vkey 直链)、网易云(VIP 试听)、推特/油管/库街区等登录态。
# 放在 git 忽略的 data/ 下，绝不提交。留空 = 匿名解析。
BOT_COOKIES_FILE=data/platform_cookies.txt
# 链接解析历史（/bot parse 查询；落盘 data/，git 忽略）
BOT_PARSE_HISTORY_ENABLED=true
BOT_PARSE_HISTORY_DB_PATH=data/parse_history.sqlite3
BOT_PARSE_HISTORY_MAX_ITEMS=2000

# 视频下载与媒体分析（yt-dlp）。
# 发视频链接会自动附加分辨率/时长/HDR/音频码率分析；/bot download <链接> 下载。
BOT_MEDIA_ANALYZE_ENABLED=true
BOT_DOWNLOAD_DIR=data/downloads
BOT_DOWNLOAD_MAX_BYTES=209715200
BOT_DOWNLOAD_MAX_HEIGHT=1080
BOT_DOWNLOAD_TIMEOUT_SECONDS=300
# 代理（油管/推特/Spotify/Pixiv 走代理，形如 http://127.0.0.1:7890；留空=直连）
BOT_DOWNLOAD_PROXY=http://127.0.0.1:7890

# HTML 信息卡渲染（解析结果渲染成 PNG 图片一起发送）
BOT_CARD_RENDER_ENABLED=true
BOT_CARD_RENDER_BACKEND=playwright
BOT_CARD_RENDER_DIR=data/cards
# 「历史上的今天」：发『历史上的今天』查询；『历史上的今天 设置 8:00』每日定时推送。
# 数据源：百度百科公开接口（每日缓存，失败退旧缓存）。
BOT_TODAY_HISTORY_ENABLED=true
BOT_TODAY_HISTORY_PUSH_FILE=data/today_history_push.json
# 维基百科查询（bot.wiki）：『维基 <词条>』，MediaWiki 公开 API 免 key。
BOT_WIKI_ENABLED=true
BOT_WIKI_LANG=zh
# Epic 每周免费游戏（bot.epic）：『epic』，Epic 公开接口免 key。
BOT_EPIC_ENABLED=true
# 中文天气查询（bot.weather）：『天气 <城市>』/『天气 省份-城市』，
# 数据源：中国气象局 NMC（免 key，内置 2527 区县码表）。
BOT_WEATHER_QUERY_ENABLED=true

# 长回复合并转发：文本超过该长度时渲染成合并转发消息（QQ 私聊/群聊），0 = 永不拆分、单条直发；
# transport 不支持 forward 时自动降级回纯文本。
BOT_RENDER_FORWARD_MIN_CHARS=0
BOT_RENDER_FORWARD_MAX_NODES=6
BOT_RENDER_FORWARD_NODE_CHARS=900

# 文件审计日志：JSONL 脱敏轮转（data/ 已被 git 忽略）。
BOT_AUDIT_LOG_FILE=
BOT_AUDIT_LOG_MAX_BYTES=2097152

# 外部抓取凭据：填 data/credentials.json（已被 git 忽略），
# 或使用 BOT_CREDENTIAL_<ID> 环境变量。凭据不会进入日志与 prompt。
BOT_CREDENTIALS_FILE=
# 凭据健康检查：开机/定时检查 expires_at，临近过期或失效时预警"重新登录"。
BOT_CREDENTIAL_WARN_DAYS=7
BOT_CREDENTIAL_PROBE_URLS={}
BOT_CREDENTIAL_PROBE_TIMEOUT_SECONDS=8
# NoneBot 入口的定时检查（开机即查一次，之后按小时间隔）。
BOT_CREDENTIAL_CHECK_ENABLED=false
BOT_CREDENTIAL_CHECK_INTERVAL_HOURS=6

BOT_CHAT_ENABLED=true
BOT_CHAT_PROVIDER=static
BOT_CHAT_MODEL=static
# 模型预设（flash/pro 快捷切换；对话里 /bot runtime model set flash 或 /model flash）
BOT_MODEL_PRESETS={"flash":"deepseek-v4-flash","pro":"deepseek-v4-pro"}
BOT_CHAT_API_KEY=
# 可以填写根地址 /v1，也可以填写完整 /chat/completions endpoint。
BOT_CHAT_BASE_URL=https://api.openai.com/v1
# temperature 0.0-2.0；max_tokens 0=不设上限（不传给 API）；timeout_seconds > 0。
BOT_CHAT_TEMPERATURE=0.7
BOT_CHAT_MAX_TOKENS=0
BOT_CHAT_TIMEOUT_SECONDS=30

# 备用人格（人格切换）：JSON 格式，weight=随机切换概率，emotions=情绪触发
# （例如 support_needed/help_seeking）。管理员可随时用 /bot runtime persona 指令切换。
BOT_PERSONA_ALT_PROFILES={}
# GsCore（gsuid-core / 早柚核心）适配桥：连接 ws://HOST:PORT/BOT_ID?token=TOKEN
# 本机部署可不开；跨机器必须配 WS_TOKEN 或 TrustIP。路由 BOT_ID 是平台名（NoneBot2）。
BOT_GSCORE_ENABLED=false
BOT_GSCORE_HOST=127.0.0.1
BOT_GSCORE_PORT=8765
BOT_GSCORE_WS_TOKEN=
BOT_GSCORE_MAX_RETRY=5
BOT_GSCORE_BOT_ID=NoneBot2
BOT_GSCORE_BOT_SELF_ID=
# 模型注册表（自动路由 + 失败自动切换）。api_key 用 env:变量名 引用密钥，不写明文；
# 也支持列表 ["env:KEY_A","env:KEY_B"]：同模型按顺序做密钥故障转移。
# tags: fast=快/便宜（普通对话默认档），strong=强（复杂任务自动升级档）。
# 自动选型规则：长文本/教程/排查/分析/写作类 → strong 档；其余 → fast 档；
# 同档按 priority 依次尝试，全部失败自动转移到另一档。
BOT_MODEL_AUTO_ROUTE=true
BOT_MODEL_REGISTRY={"flash":{"model":"deepseek-v4-flash","base_url":"https://api.deepseek.com/v1","api_key":["env:BOT_API_KEY_DEEPSEEK","env:BOT_API_KEY_DEEPSEEK_2"],"tags":["fast"],"priority":1},"pro":{"model":"deepseek-v4-pro","base_url":"https://api.deepseek.com/v1","api_key":["env:BOT_API_KEY_DEEPSEEK","env:BOT_API_KEY_DEEPSEEK_2"],"tags":["strong"],"priority":2},"terra":{"model":"gpt-5.6-terra","base_url":"https://api.openai.com/v1","api_key":"env:BOT_API_KEY_OPENAI","tags":["strong"],"priority":3},"sol":{"model":"gpt-5.6-sol","base_url":"https://api.openai.com/v1","api_key":"env:BOT_API_KEY_OPENAI","tags":["strong"],"priority":4},"gemini-flash":{"model":"gemini-3.7-flash","base_url":"https://generativelanguage.googleapis.com/v1beta/openai","api_key":"env:BOT_API_KEY_GEMINI","tags":["fast"],"priority":5}}
# 各供应商密钥（注册表 api_key 通过 env:BOT_API_KEY_* 引用）
BOT_API_KEY_DEEPSEEK=
BOT_API_KEY_DEEPSEEK_2=
BOT_API_KEY_OPENAI=
BOT_API_KEY_GEMINI=

# 订阅系统基础框架（/bot subscribe）：定时拉取平台新内容并私聊/群聊推送。
# enabled=false 时完全不注册订阅调度任务；DB 落在 data/（已 git 忽略）。
BOT_SUBSCRIBE_ENABLED=true
BOT_SUBSCRIBE_DB_PATH=data/subscriptions.sqlite3
# 常规新内容轮询间隔（秒）；直播状态轮询间隔（秒）。
BOT_SUBSCRIBE_POLL_INTERVAL_SECONDS=300
BOT_SUBSCRIBE_LIVE_POLL_SECONDS=60
# 日报汇总的每日推送时间（24 小时制）。
BOT_SUBSCRIBE_DIGEST_HOUR=20
BOT_SUBSCRIBE_DIGEST_MINUTE=0
# 单次轮询最多处理的新条目数，超出部分下轮继续。
BOT_SUBSCRIBE_MAX_ITEMS_PER_TICK=20
# Playwright 带 cookie 抓取兜底（小红书等签名受限平台）；默认开启，关闭则退回直连/og 浅层
BOT_FETCH_PLAYWRIGHT_ENABLED=true
# 运行时事件日志：毫秒时间戳 + INFO/WARNING/ERROR 分级，/bot logs [级别] [条数] 查询（仅管理员）
BOT_RUNTIME_LOG_FILE=data/runtime_events.log
BOT_RUNTIME_LOG_MAX_BYTES=2097152
BOT_RUNTIME_LOG_LEVEL=INFO
# 订阅轮询在 Playwright 兜底模式下的间隔（秒），所有轮询额外带 60s 抖动
BOT_SUBSCRIBE_PLAYWRIGHT_POLL_SECONDS=1800

# nonebot-plugin-orm PostgreSQL 底座：把 USER/PASSWORD/HOST/PORT/DBNAME 替换成实际值；
# 密码含 @ 时把 @ 编码为 %40（例如 ElonaSerikas@233 -> ElonaSerikas%40233）。
SQLALCHEMY_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@127.0.0.1:5432/chatbot

# 向量知识库：启用后知识库按查询语义检索最相关块注入 LLM 回复指引。
# 服务必须是任意 OpenAI-compatible embeddings 服务。阿里云百炼示例：
#   BOT_EMBEDDING_MODEL=qwen3.7-text-embedding,text-embedding-v4
#   （逗号分隔=优先用前者，配额耗尽/失败自动回退后者）
#   BOT_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 若百炼控制台给出 WorkspaceId 地域地址，可改为 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 嵌入或检索失败会自动回退关键词/顺序取块，不会导致崩溃。
# API Key 请通过环境变量注入，不要写明文；本文件不包含任何真实密钥。
BOT_EMBEDDING_ENABLED=false
BOT_EMBEDDING_MODEL=
BOT_EMBEDDING_BASE_URL=
BOT_EMBEDDING_API_KEY=
BOT_EMBEDDING_TIMEOUT_SECONDS=30
BOT_EMBEDDING_DIMENSIONS=1024
# 本地优先：Ollama OpenAI 兼容端点（/v1/embeddings），失败自动回退上面的远程模型。
#   BOT_EMBEDDING_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
#   BOT_EMBEDDING_LOCAL_MODELS=bge-m3
BOT_EMBEDDING_LOCAL_ENABLED=true
BOT_EMBEDDING_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
BOT_EMBEDDING_LOCAL_MODELS=bge-m3
BOT_EMBEDDING_LOCAL_TIMEOUT_SECONDS=60
BOT_KNOWLEDGE_TOP_K=5
BOT_KNOWLEDGE_DB_PATH=data/knowledge_embeddings.sqlite3
# 多实例共享组：组名建议写成 "A and B"、"A and B and C" 形式
BOT_SHARE_ENABLED=false
BOT_SHARE_GROUPS=[]
BOT_SHARE_READ_ONLY=false
